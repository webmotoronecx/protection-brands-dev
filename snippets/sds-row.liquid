{%- doc -%}
  Renders one Safety Data Sheet row for the SDS list block.

  @param {object} document - An `sds_document` metaobject entry
  @param {object} block - The SDS list block, for its label settings
{%- enddoc -%}

{%- liquid
  assign name = document.product_name.value
  assign file = document.file.value
  assign search_text = name | append: ' ' | append: document.brand.value | downcase | escape
-%}

{%- if name != blank and file != blank -%}
  <li class="sds-list__row" data-sds-search="{{ search_text }}">
    <div>
      <p class="sds-list__name">{{ name }}</p>
      {%- if document.issue_date.value != blank -%}
        <p class="sds-list__meta">
          {{ block.settings.issued_label }}
          {{ document.issue_date.value | date: format: 'date' }}
        </p>
      {%- endif -%}
    </div>
    <a
      class="sds-list__download link"
      href="{{ file.url }}"
      target="_blank"
      rel="noopener"
      aria-label="{{ block.settings.download_label }}: {{ name }}"
    >
      {{- block.settings.download_label -}}
    </a>
  </li>
{%- endif -%}
