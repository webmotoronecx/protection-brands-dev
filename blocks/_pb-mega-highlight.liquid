{%- comment -%}
  A highlight card in a PB mega menu panel (blocks/_pb-mega-panel.liquid): a dark rounded card
  with a photo behind, a small red eyebrow at the top ("Limited time offer") and a large heading
  in the heading font at the bottom. Either a custom promo (image, heading, link) or a picked
  product (its image, title and URL); a product card's own image or heading override the
  product's when set. The product's own image is a packshot, so it sits whole on the right
  instead of filling the card. Markup: snippets/pb-mega-card.liquid.
{%- endcomment -%}

{%- liquid
  assign image = block.settings.image
  assign heading = block.settings.heading
  assign url = block.settings.link
  assign packshot = false

  if block.settings.type == 'product' and block.settings.product != blank
    assign card_product = block.settings.product
    if image == blank
      assign image = card_product.featured_media.preview_image
      assign packshot = true
    endif
    if heading == blank
      assign heading = card_product.title
    endif
    assign url = card_product.url
  endif
-%}

{%- render 'pb-mega-card',
  image: image,
  heading: heading,
  eyebrow: block.settings.eyebrow,
  url: url,
  packshot: packshot,
  attributes: block.shopify_attributes
-%}

{% schema %}
{
  "name": "Highlight",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "type",
      "label": "Type",
      "options": [
        {
          "value": "custom",
          "label": "Custom promo"
        },
        {
          "value": "product",
          "label": "Product"
        }
      ],
      "default": "custom"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Used when Type is Product."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Landscape, about 16:11. The card is dark, so a dark photo works best. For a product, empty uses the product's image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited time offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "For a product, empty uses the product title."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "visible_if": "{{ block.settings.type == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Highlight"
    }
  ]
}
{% endschema %}
