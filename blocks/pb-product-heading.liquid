{%- comment -%}
  Product page heading (Protection Brands): a small breadcrumb, a red label (the product's
  category, snippets/pb-product-category.liquid, or its brand), the product title large and
  uppercase, and "Suitable for" tags from the custom.suitable_for metafield (Permagard /
  CERFACE / OptiVAN).

  On templates/product.json the breadcrumb and tags are off: the breadcrumb is at the top of
  the card (sections/pb-breadcrumb-bar.liquid), and Horizon's review block follows with the
  stars. The title is in the heading font's medium weight, loaded on product pages by
  snippets/pb-head.liquid (--pb-heading-medium-weight).
{%- endcomment -%}

{%- liquid
  assign product = closest.product

  # Breadcrumb collection: the one the visitor came from, else the product's first collection
  # (skipping the home page and catch-all collections).
  assign crumb = collection
  if crumb == blank
    for item in product.collections
      unless item.handle == 'frontpage' or item.handle == 'all'
        assign crumb = item
        break
      endunless
    endfor
  endif

  assign label = blank
  case block.settings.label_source
    when 'category'
      capture label
        render 'pb-product-category', product: product
      endcapture
    when 'vendor'
      assign label = product.vendor | escape
  endcase

  assign suitable_for = blank
  if block.settings.show_suitable
    assign suitable_for = product.metafields.custom.suitable_for.value
  endif

  assign heading_font = settings.type_heading_font
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
</style>

<div
  class="pb-product-heading"
  style="--pb-product-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --pb-product-heading-weight: {{ heading_font.weight }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_breadcrumb -%}
    <nav class="pb-product-heading__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      {%- if crumb != blank -%}
        <span aria-hidden="true">/</span>
        <a href="{{ crumb.url }}">{{ crumb.title }}</a>
      {%- endif -%}
    </nav>
  {%- endif -%}

  {%- if label != blank -%}
    <p class="pb-product-heading__brand">{{ label }}</p>
  {%- endif -%}

  <h1 class="pb-product-heading__title">{{ product.title }}</h1>

  {%- if suitable_for != blank -%}
    <div class="pb-product-heading__tags">
      <span class="pb-product-heading__tags-label">{{ block.settings.suitable_label }}</span>
      <ul>
        {%- for item in suitable_for -%}
          <li>{{ item }}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Sizes from the 1440px design: label, title and stars 31px apart. */
  .pb-product-heading {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.15vw, 31px);
  }

  .pb-product-heading__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: #9a9a9a;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pb-product-heading__crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .pb-product-heading__crumbs a:is(:hover, :focus-visible) {
    color: #111;
  }

  .pb-product-heading__brand {
    margin: 0;
    color: var(--pb-accent, #ca0d0d);
    font-size: 14px;
    font-weight: 700;
    line-height: normal;
    text-transform: uppercase;
  }

  .pb-product-heading__title {
    margin: 0;
    color: #000;
    font-family: var(--pb-product-heading-font, inherit);
    font-size: clamp(1.9rem, 2.8vw, 2.5rem);
    font-weight: var(--pb-heading-medium-weight, var(--pb-product-heading-weight, 400));
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .pb-product-heading__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .pb-product-heading__tags-label {
    color: #6f6f6f;
    font-size: 13px;
  }

  .pb-product-heading__tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pb-product-heading__tags li {
    padding: 5px 10px;
    border-radius: 6px;
    background: #f4f4f4;
    color: #111;
    font-size: 12px;
    font-weight: 500;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product heading (PB)",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": false
    },
    {
      "type": "select",
      "id": "label_source",
      "label": "Label above the title",
      "options": [
        {
          "value": "category",
          "label": "Category"
        },
        {
          "value": "vendor",
          "label": "Brand"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "category",
      "info": "Category: the first of the product's tags listed under Theme settings > Products (Protection Brands), else its product type."
    },
    {
      "type": "checkbox",
      "id": "show_suitable",
      "label": "Show \"Suitable for\" tags",
      "info": "From the product's custom.suitable_for metafield.",
      "default": false
    },
    {
      "type": "text",
      "id": "suitable_label",
      "label": "Suitable for label",
      "default": "Suitable for",
      "visible_if": "{{ block.settings.show_suitable }}"
    }
  ],
  "presets": [
    {
      "name": "Product heading (PB)"
    }
  ]
}
{% endschema %}
