{%- comment -%}
  Product page features (Protection Brands): a row of up to three short promises under the
  buy buttons, each a red icon over a few words in the heading font, e.g. "Dispatched within
  48 hours". The same on every product; each can link somewhere (the delivery and returns
  page).

  Icons are the Figma design's Carbon icons (assets/pb-icon-*.svg), drawn as CSS masks so
  they take the brand red (--pb-accent) rather than the files' own #FF0000. Used on
  templates/product.json; styles here, spacing in the product column in assets/pb-product.css.
{%- endcomment -%}

{%- liquid
  assign heading_font = settings.type_heading_font
  assign items = '1,2,3' | split: ','
-%}

<ul
  class="pb-product-features"
  role="list"
  style="--pb-features-font: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --pb-features-weight: {{ heading_font.weight }};"
  {{ block.shopify_attributes }}
>
  {%- for i in items -%}
    {%- liquid
      assign text_key = 'text_' | append: i
      assign icon_key = 'icon_' | append: i
      assign link_key = 'link_' | append: i
      assign text = block.settings[text_key]
      assign icon = block.settings[icon_key]
      assign link = block.settings[link_key]
    -%}
    {%- if text != blank -%}
      <li class="pb-product-features__item">
        {%- if link != blank -%}<a href="{{ link }}">{%- endif -%}
        {%- if icon != 'none' -%}
          {%- assign icon_file = 'pb-icon-' | append: icon | append: '.svg' -%}
          <span class="pb-product-features__icon" style="--pb-icon: url('{{ icon_file | asset_url }}');" aria-hidden="true"></span>
        {%- endif -%}
        <span class="pb-product-features__text">{{ text | escape }}</span>
        {%- if link != blank -%}</a>{%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

{% stylesheet %}
  /* 1440px design: 30px icons, the words 37px below them, items 39px apart. Always one row;
     on narrow columns the words wrap instead. */
  .pb-product-features {
    display: grid;
    grid-auto-columns: minmax(0, 7.2em);
    grid-auto-flow: column;
    justify-content: start;
    column-gap: clamp(16px, 2.7vw, 39px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pb-product-features__item {
    color: #000;
    font-family: var(--pb-features-font, inherit);
    font-size: 14px;
    font-weight: var(--pb-heading-medium-weight, var(--pb-features-weight, 400));
    line-height: 19.8px;
    text-transform: uppercase;
  }

  .pb-product-features__item a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .pb-product-features__item a:is(:hover, :focus-visible) .pb-product-features__text {
    text-decoration: underline;
    text-decoration-color: var(--pb-accent, #ca0d0d);
    text-underline-offset: 3px;
  }

  .pb-product-features__icon {
    display: block;
    width: 30px;
    height: 30px;
    margin-block-end: clamp(16px, 2.6vw, 37px);
    background-color: var(--pb-accent, #ca0d0d);
    -webkit-mask: var(--pb-icon) center / contain no-repeat;
    mask: var(--pb-icon) center / contain no-repeat;
  }

  .pb-product-features__text {
    display: block;
  }
{% endstylesheet %}

