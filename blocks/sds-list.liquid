{%- comment -%}
  Lists Safety Data Sheets from the `sds_document` metaobject, grouped by brand.
  Fields: product_name (text), file (PDF), brand (text, preset choices), issue_date (date).
{%- endcomment -%}

{%- liquid
  assign brand_order = block.settings.brand_order | split: ','
  assign known_brands = ''
-%}

<sds-list
  class="sds-list spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {%- paginate shop.metaobjects.sds_document.values by 250 -%}
    {%- assign documents = shop.metaobjects.sds_document.values -%}

    {%- if documents.size == 0 -%}
      <p class="sds-list__empty">{{ block.settings.empty_text }}</p>
    {%- else -%}
      <div class="sds-list__search field" hidden>
        <label class="visually-hidden" for="SdsSearch-{{ block.id }}">{{ block.settings.search_label }}</label>
        <input
          type="search"
          id="SdsSearch-{{ block.id }}"
          class="field__input"
          placeholder="{{ block.settings.search_label }}"
          autocomplete="off"
          ref="input"
        >
      </div>

      {%- for brand_name in brand_order -%}
        {%- assign brand = brand_name | strip -%}
        {%- assign known_brands = known_brands | append: '|' | append: brand | append: '|' -%}
        {%- capture rows -%}
          {%- for document in documents -%}
            {%- if document.brand.value == brand -%}
              {% render 'sds-row', document: document, block: block %}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if rows != blank -%}
          <section class="sds-list__group" data-sds-group>
            <h2 class="h4">{{ brand }}</h2>
            <ul class="sds-list__rows" role="list">
              {{ rows }}
            </ul>
          </section>
        {%- endif -%}
      {%- endfor -%}

      {%- capture other_rows -%}
        {%- for document in documents -%}
          {%- assign brand_key = '|' | append: document.brand.value | append: '|' -%}
          {%- unless known_brands contains brand_key -%}
            {% render 'sds-row', document: document, block: block %}
          {%- endunless -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if other_rows != blank -%}
        <section class="sds-list__group" data-sds-group>
          <h2 class="h4">{{ block.settings.other_heading }}</h2>
          <ul class="sds-list__rows" role="list">
            {{ other_rows }}
          </ul>
        </section>
      {%- endif -%}

      <p class="sds-list__empty" hidden ref="noResults">{{ block.settings.no_results_text }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</sds-list>

{% stylesheet %}
  .sds-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl, 32px);
    width: 100%;
  }

  .sds-list__search {
    max-width: 28rem;
  }

  .sds-list__group h2 {
    margin-block-end: var(--padding-sm, 12px);
  }

  .sds-list__rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-color);
  }

  .sds-list__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--padding-xs, 8px) var(--padding-sm, 12px);
    padding-block: var(--padding-sm, 12px);
    border-bottom: 1px solid var(--border-color);
  }

  .sds-list__name {
    margin: 0;
    font-weight: 600;
  }

  .sds-list__meta {
    margin: 0;
    opacity: 0.7;
    font-size: 0.875em;
  }

  .sds-list__download {
    white-space: nowrap;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('sds-list')) {
    customElements.define(
      'sds-list',
      class SdsList extends HTMLElement {
        connectedCallback() {
          this.input = this.querySelector('[ref="input"]');
          this.noResults = this.querySelector('[ref="noResults"]');
          if (!this.input) return;

          this.input.closest('.sds-list__search').hidden = false;
          this.input.addEventListener('input', () => this.filter());
        }

        filter() {
          const query = this.input.value.trim().toLowerCase();
          let visibleTotal = 0;

          this.querySelectorAll('[data-sds-group]').forEach((group) => {
            let visibleInGroup = 0;
            group.querySelectorAll('[data-sds-search]').forEach((row) => {
              const match = row.dataset.sdsSearch.includes(query);
              row.hidden = !match;
              if (match) visibleInGroup++;
            });
            group.hidden = visibleInGroup === 0;
            visibleTotal += visibleInGroup;
          });

          this.noResults.hidden = visibleTotal > 0;
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "SDS list",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows every entry of the SDS document metaobject (Content → Metaobjects)."
    },
    {
      "type": "text",
      "id": "brand_order",
      "label": "Brand order",
      "info": "Comma-separated. Must match the metaobject's brand choices. Anything else is listed under the heading below.",
      "default": "Permagard, CERFACE, OptiVAN, Honda Genuine Car Care, Protection Brands"
    },
    {
      "type": "text",
      "id": "other_heading",
      "label": "Heading for other documents",
      "default": "Other products"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search placeholder",
      "default": "Search by product name"
    },
    {
      "type": "text",
      "id": "download_label",
      "label": "Download link text",
      "default": "Download PDF"
    },
    {
      "type": "text",
      "id": "issued_label",
      "label": "Issue date label",
      "default": "Issued"
    },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "No search results text",
      "default": "No safety data sheets match your search."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty list text",
      "default": "Safety data sheets will be available here soon."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "SDS list"
    }
  ]
}
{% endschema %}
