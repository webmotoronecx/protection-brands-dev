    "pb_brand_intro": {
      "type": "pb-feature-rows",
      "blocks": {
        "row_1": {
          "type": "row",
          "settings": {
            "layout": "text",
            "heading": "Advanced Vehicle Protection, Trusted by Leading Automotive Brands",
            "text": "<p>At Protection Brands, we believe vehicle protection is about more than preserving a finish. It's about protecting the pride of ownership, the enjoyment of every drive, and the investment you've made in your vehicle.</p><p>As a leading Australian automotive protection company, Protection Brands specialises in the development, manufacture and distribution of premium vehicle protection technologies. Our extensive portfolio includes exclusive products and advanced protection systems designed to help preserve the appearance, condition and enjoyment of your vehicle, both inside and out.</p><p>Our commitment to innovation goes beyond simply supplying products. We work closely with specialist manufacturers, research and development teams and automotive industry partners to develop exclusive protection solutions that deliver exceptional performance, durability and long-term benefits for vehicle owners.</p>",
            "label": "Protection Brands"
          }
        }
      },
      "block_order": [
        "row_1"
      ],
      "settings": {
        "row_gap": 96,
        "background": "#ffffff",
        "text_color": "#111111"
      }
    },
