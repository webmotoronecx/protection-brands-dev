    "pb_brand_intro": {
      "type": "pb-feature-rows",
      "blocks": {
        "row_1": {
          "type": "row",
          "settings": {
            "layout": "text",
            "heading": "Protect Your Home Away From Home.",
            "text": "<p>Your caravan, camper, RV or motorhome is built for adventure. OptiVAN is designed to help protect it every step of the way.</p><p>Developed specifically for Australian touring conditions, OptiVAN combines advanced exterior and interior protection technologies to help preserve your vehicle's appearance, reduce maintenance and protect your investment.</p>",
            "label": "OptiVAN"
          }
        }
      },
      "block_order": [
        "row_1"
      ],
      "settings": {
        "row_gap": 96,
        "background": "#ffffff",
        "text_color": "#111111"
      }
    },
