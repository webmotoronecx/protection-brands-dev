    "pb_brand_rows": {
      "type": "pb-feature-rows",
      "blocks": {
        "row_1": {
          "type": "row",
          "settings": {
            "layout": "image_left",
            "heading": "Protection Beyond the Exterior",
            "text": "<p>CERFACE BEYOND Interior Protection complements the exterior coating by helping protect leather, fabric, carpet, vinyl and interior trim surfaces. The invisible protective barrier helps reduce the impact of everyday spills, stains, soiling and UV-related wear, helping maintain the appearance and comfort of your vehicle's interior.</p>",
            "watermark": "CERFACE"
          }
        },
        "row_2": {
          "type": "row",
          "settings": {
            "layout": "image_right",
            "heading": "Professionally Applied. Backed by Experience.",
            "text": "<p>Unlike many retail ceramic coatings, CERFACE is professionally applied by trained specialists through selected dealership partners. Every application is supported by Protection Brands’ national customer care and warranty program, providing added confidence and long-term support.</p>"
          }
        },
        "row_3": {
          "type": "row",
          "settings": {
            "layout": "image_left",
            "heading": "Designed for Owners Who Value Their Vehicle",
            "text": "<p>Whether you're driving a luxury European vehicle, a family SUV, a performance car or your everyday pride and joy, CERFACE is designed for owners who appreciate quality, value their investment and want their vehicle looking its very best.</p><p>CERFACE isn't simply about protecting your vehicle today. It's about preserving everything you love about it for the journeys ahead.</p>"
          }
        }
      },
      "block_order": [
        "row_1",
        "row_2",
        "row_3"
