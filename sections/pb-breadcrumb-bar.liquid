{%- comment -%}
  Breadcrumb bar (Protection Brands), at the top of the product page. Two layouts:

  - Bar: a slim version of the dark title bar (sections/pb-collection-header.liquid) with
    "Shop / <collection>" in white.
  - Card (templates/product.json): the top of the white product card, under the dark header
    (sections/pb-landing-header.liquid floats over it there). Small grey capitals,
    "Home / <category> / <product>", with the product in black. The product section below
    continues the card (assets/pb-product.css), so the two read as one.
  - On the page (templates/collection.json, page.json): the card's small grey capitals on the
    white page, no card. "Home / <collection>" lined up with the product grid, or
    "Home / <page>" lined up with the page's text column; the last crumb in black.

  The middle crumb is the collection the visitor came from. Otherwise, in the card layout,
  the product's category tag (snippets/pb-product-category.liquid), linking to all products
  with that tag; failing both, the product's first collection (skipping the home page and
  catch-all collections).
{%- endcomment -%}

{%- liquid
  assign card = false
  assign inline = false
  if section.settings.layout == 'card'
    assign card = true
  elsif section.settings.layout == 'inline'
    assign inline = true
  endif

  assign crumb_title = blank
  assign crumb_url = blank
  if request.page_type == 'page'
    assign crumb_title = page.title | escape
    assign crumb_url = page.url
  elsif collection != blank
    assign crumb_title = collection.title | escape
    assign crumb_url = collection.url
  elsif product != blank
    if card
      capture category
        render 'pb-product-category', product: product, fallback: false
      endcapture
      if category != blank
        assign category_handle = category | handle
        assign crumb_title = category
        assign crumb_url = routes.all_products_collection_url | append: '/' | append: category_handle
      endif
    endif
    if crumb_title == blank
      for item in product.collections
        unless item.handle == 'frontpage' or item.handle == 'all'
          assign crumb_title = item.title | escape
          assign crumb_url = item.url
          break
        endunless
      endfor
    endif
  endif
-%}

<div class="pb-breadcrumb-bar{% if card %} pb-breadcrumb-bar--card{% endif %}{% if inline %} pb-breadcrumb-bar--inline section{% if request.page_type == 'page' %} page-width-content{% endif %}{% endif %}">
  {%- if section.settings.marquee and card == false and inline == false -%}
    {%- render 'pb-marquee',
      class: 'pb-breadcrumb-bar__marquee',
      file: 'label-scroling-invert.svg',
      static: true,
      follow_mouse: true,
      loading: 'eager'
    -%}
  {%- endif -%}

  <nav class="pb-breadcrumb-bar__crumbs" aria-label="Breadcrumb">
    <ol>
      {%- if card or inline -%}
        <li><a href="{{ routes.root_url }}">{{ section.settings.home_label }}</a></li>
      {%- else -%}
        <li><a href="{{ routes.all_products_collection_url }}">{{ section.settings.shop_label }}</a></li>
      {%- endif -%}
      {%- if crumb_title != blank -%}
        {%- if inline and product == blank -%}
          <li><span aria-current="page">{{ crumb_title }}</span></li>
        {%- else -%}
          <li><a href="{{ crumb_url }}">{{ crumb_title }}</a></li>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.show_product and product != blank -%}
        <li><span aria-current="page">{{ product.title }}</span></li>
      {%- endif -%}
    </ol>
  </nav>
</div>

{% stylesheet %}
  .pb-breadcrumb-bar {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 0 10px 14px;
    padding: 24px clamp(20px, 2.8vw, 44px);
    border-radius: 12px;
    background:
      radial-gradient(ellipse 60% 90% at 20% 60%, #1c1c1c 0%, transparent 70%),
      linear-gradient(120deg, #111 0%, #0b0b0b 60%, #0d0d0d 100%);
    color: #fff;
  }

  /* Wordmark behind, larger than the bar so only part of it shows. */
  .pb-breadcrumb-bar__marquee {
    --pb-marquee-height: clamp(5rem, 12vw, 12rem);

    position: absolute;
    inset-inline: -80px;
    inset-block-start: 50%;
    z-index: -1;
    translate: 0 -55%;
  }

  .pb-breadcrumb-bar__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 17px;
  }

  .pb-breadcrumb-bar__crumbs li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .pb-breadcrumb-bar__crumbs li + li::before {
    content: '/';
    color: rgb(255 255 255 / 0.6);
  }

  .pb-breadcrumb-bar__crumbs a {
    color: #fff;
    text-decoration: none;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .pb-breadcrumb-bar__crumbs a:is(:hover, :focus-visible) {
    text-decoration-line: underline;
    text-decoration-color: var(--pb-accent, #ca0d0d);
  }

  .pb-breadcrumb-bar__crumbs [aria-current] {
    overflow: hidden;
    color: rgb(255 255 255 / 0.5);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Card: the white top of the product card, below the floating header. Sizes follow the
     1440px design (card 31px from the screen edge, 122px from the top, 40px inside, the
     crumbs 10px further in); --pb-pdp-margin and --pb-pdp-pad come from assets/pb-product.css. */
  .pb-breadcrumb-bar--card {
    margin:
      calc(var(--pb-landing-header-height, 88px) + 34px)
      var(--pb-pdp-margin, 10px)
      0;
    padding:
      calc(var(--pb-pdp-pad, 40px) + 10px)
      calc(var(--pb-pdp-pad, 40px) + 10px)
      clamp(20px, 3vw, 44px);
    border-radius: 8px 8px 0 0;
    background: #fff;
    color: #000;
  }

  /* On the page: no card; the side margins come from Horizon's page-width grid (.section),
     set with the product grid's in assets/pb-product-card.css. */
  .pb-breadcrumb-bar--inline {
    overflow: visible;
    margin: 0;
    padding: clamp(20px, 2.2vw, 32px) 0 0;
    border-radius: 0;
    background: none;
    color: #000;
  }

  :is(.pb-breadcrumb-bar--card, .pb-breadcrumb-bar--inline) .pb-breadcrumb-bar__crumbs ol {
    gap: 4px;
    font-size: 12px;
    font-weight: 700;
    line-height: normal;
    text-transform: uppercase;
  }

  :is(.pb-breadcrumb-bar--card, .pb-breadcrumb-bar--inline) .pb-breadcrumb-bar__crumbs li {
    gap: 4px;
  }

  :is(.pb-breadcrumb-bar--card, .pb-breadcrumb-bar--inline) .pb-breadcrumb-bar__crumbs li + li::before,
  :is(.pb-breadcrumb-bar--card, .pb-breadcrumb-bar--inline) .pb-breadcrumb-bar__crumbs a {
    color: #737373;
  }

  :is(.pb-breadcrumb-bar--card, .pb-breadcrumb-bar--inline) .pb-breadcrumb-bar__crumbs a {
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  :is(.pb-breadcrumb-bar--card, .pb-breadcrumb-bar--inline) .pb-breadcrumb-bar__crumbs a:is(:hover, :focus-visible) {
    color: #000;
  }

  :is(.pb-breadcrumb-bar--card, .pb-breadcrumb-bar--inline) .pb-breadcrumb-bar__crumbs [aria-current] {
    color: #000;
  }

  @media screen and (max-width: 749px) {
    .pb-breadcrumb-bar {
      margin-inline: 8px;
      padding: 18px;
    }

    .pb-breadcrumb-bar__crumbs ol {
      font-size: 15px;
    }

    .pb-breadcrumb-bar--card {
      margin-inline: var(--pb-pdp-margin, 8px);
      padding: 20px 18px 16px;
    }

    .pb-breadcrumb-bar--inline {
      margin-inline: 0;
      padding: 20px 0 0;
    }

    .pb-breadcrumb-bar--inline .pb-breadcrumb-bar__crumbs ol {
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Breadcrumb bar (PB)",
  "tag": "section",
  "class": "pb-breadcrumb-bar-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "bar",
          "label": "Dark bar"
        },
        {
          "value": "card",
          "label": "Top of the product card"
        },
        {
          "value": "inline",
          "label": "On the page"
        }
      ],
      "default": "bar",
      "info": "\"Top of the product card\" is for the product page, under the dark header: Home / category / product. \"On the page\" is for collection pages and pages, under the title bar: Home / collection or Home / page."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "First link label",
      "default": "Shop",
      "visible_if": "{{ section.settings.layout == 'bar' }}"
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "First link label",
      "default": "Home",
      "visible_if": "{{ section.settings.layout != 'bar' }}"
    },
    {
      "type": "checkbox",
      "id": "show_product",
      "label": "Show product name",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "marquee",
      "label": "Show wordmark behind",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'bar' }}"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb bar (PB)"
    }
  ]
}
{% endschema %}
