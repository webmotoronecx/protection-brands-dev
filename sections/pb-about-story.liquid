{%- comment -%}
  About page body (Protection Brands), the body of templates/page.about.json, under the
  full-width title bar. Breadcrumb ("Home / <page>"), then the page's own text from admin,
  unchanged, laid out by CSS alone:

  - desktop: the first paragraph large in the heading font on the left (it stays in view while
    the rest scrolls), the other paragraphs on the right;
  - the last paragraph (the "find your dealer" line) as a dark card;
  - mobile: one column, in the same order.

  Admin wraps the text in a <blockquote>; its quote styling (indent, rule, italics) is removed.
  Text without the blockquote is laid out the same way.
{%- endcomment -%}

{%- liquid
  assign heading_font = settings.type_heading_font
-%}

<div
  class="pb-about"
  style="--pb-about-font: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --pb-about-weight: {{ heading_font.weight }};"
>
  <nav class="pb-about__crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="{{ routes.root_url }}">{{ section.settings.home_label }}</a></li>
      <li><span aria-current="page">{{ page.title | default: section.settings.fallback_title }}</span></li>
    </ol>
  </nav>

  {%- if page.content != blank -%}
    <div class="pb-about__body">{{ page.content }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Section-specific styles for pb-about-story. */

  .pb-about {
    display: block;
    padding: 24px clamp(20px, 3vw, 44px) clamp(56px, 8vw, 120px);
  }

  .pb-about__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    font-weight: 700;
    line-height: normal;
    text-transform: uppercase;
  }

  .pb-about__crumbs li {
    display: flex;
    gap: 4px;
  }

  .pb-about__crumbs li + li::before {
    content: '/';
    color: #737373;
  }

  .pb-about__crumbs a {
    color: #737373;
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .pb-about__crumbs a:is(:hover, :focus-visible) {
    color: #000;
    text-decoration-line: underline;
  }

  .pb-about__crumbs [aria-current] {
    color: #000;
  }

  .pb-about__body {
    max-width: 1280px;
    margin: clamp(40px, 6vw, 88px) 0 0;
    color: #222;
    font-size: 17px;
    line-height: 1.65;
  }

  /* The text sits in admin's <blockquote>, or straight in the body when there isn't one. */
  .pb-about__body blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-style: normal;
  }

  :is(.pb-about__body:has(> blockquote) > blockquote, .pb-about__body:not(:has(> blockquote))) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .pb-about__body p {
    margin: 0;
  }

  /* Margins, not row-gap: on desktop the opening line spans empty rows, which a gap would pad. */
  .pb-about__body p + p {
    margin-block-start: 1.1em;
  }

  .pb-about__body :is(b, strong) {
    color: #000;
    font-weight: 700;
  }

  .pb-about__body a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--pb-accent, #ca0d0d);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .pb-about__body a:is(:hover, :focus-visible) {
    color: var(--pb-accent, #ca0d0d);
  }

  /* The opening line, large in the heading font. */
  .pb-about__body p:first-of-type {
    margin-block-end: 0.4em;
    color: #000;
    font-family: var(--pb-about-font, inherit);
    font-size: clamp(26px, 2.6vw, 40px);
    font-weight: var(--pb-about-weight, 400);
    line-height: 1.15;
  }

  .pb-about__body p:first-of-type :is(b, strong) {
    color: var(--pb-accent, #ca0d0d);
    font-weight: inherit;
  }

  /* The "find your dealer" line as a dark card. */
  .pb-about__body p:last-of-type:not(:first-of-type) {
    margin-block-start: 2em;
    padding: clamp(22px, 2.4vw, 32px) clamp(22px, 2.6vw, 36px);
    border-inline-start: 4px solid var(--pb-accent, #ca0d0d);
    border-radius: 12px;
    background: #111;
    color: #fff;
    font-size: 16px;
  }

  @media screen and (min-width: 990px) {
    :is(.pb-about__body:has(> blockquote) > blockquote, .pb-about__body:not(:has(> blockquote))) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(48px, 7vw, 120px);
    }

    .pb-about__body p {
      grid-column: 2;
    }

    /* Spans the right-hand rows and stays in view while they scroll past. */
    .pb-about__body p:first-of-type {
      grid-column: 1;
      grid-row: 1 / span 20;
      align-self: start;
      position: sticky;
      inset-block-start: calc(var(--pb-landing-header-height, 88px) + 32px);
      margin: 0;
    }

    .pb-about__body p:nth-of-type(2) {
      margin-block-start: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About story (PB)",
  "tag": "section",
  "class": "pb-about-story-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the page's own text (Online Store → Pages). Edit the words there."
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Breadcrumb home",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Breadcrumb page name",
      "info": "Used when the page has no title, e.g. in the theme editor preview.",
      "default": "About Us"
    }
  ],
  "presets": [
    {
      "name": "About story (PB)"
    }
  ]
}
{% endschema %}
