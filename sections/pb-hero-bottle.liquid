{%- comment -%}
  Protection Brands homepage hero: one or two 3D product bottles that spin, float and
  follow the mouse, between two linked headings. The 3D is drawn by assets/pb-hero-bottle.js
  with Three.js, which loads after the page has shown. The still image (if set) shows
  first and stays for visitors who turn off motion or whose device can't draw 3D.
{%- endcomment -%}

{%- liquid
  assign label_url = 'pb-label-detailing-spray.jpg' | asset_url
  if section.settings.label != blank
    assign label_url = section.settings.label | image_url: width: 4096
  endif

  assign poster_alt = section.settings.poster.alt | default: 'Protection Brands Detailing Spray'


  # Headings use a light weight of the body font (Manrope 300), loaded only here.
  assign heading_font = settings.type_body_font | font_modify: 'weight', '300'
  if heading_font == blank
    assign heading_font = settings.type_body_font
  endif
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
</style>

<pb-hero-bottle
  class="pb-hero-bottle{% if section.settings.poster != blank %} pb-hero-bottle--has-poster{% endif %}"
  data-three="{{ 'three.module.min.js' | asset_url }}"
  data-label="{{ label_url }}"
  data-bottles="{{ section.settings.bottles }}"
  data-liquid="{{ section.settings.liquid_color }}"
  data-liquid-second="{{ section.settings.liquid_color_2 }}"
  data-finish-second="{{ section.settings.liquid_finish_2 }}"
  data-size="{{ section.settings.bottle_size | divided_by: 100.0 }}"
  data-highlights="{{ section.settings.highlights | divided_by: 100.0 }}"
  data-gloss="{{ section.settings.gloss | divided_by: 100.0 }}"
  data-key-light="{{ section.settings.key_light | divided_by: 100.0 }}"
  data-rim-light="{{ section.settings.rim_light | divided_by: 40.0 }}"
  data-rim-color="{{ section.settings.rim_color }}"
  data-shadow="{{ section.settings.shadow | divided_by: 100.0 }}"
  data-shadow-blur="{{ section.settings.shadow_blur | times: 0.48 }}"
  data-wobble="{{ section.settings.liquid_wobble }}"
  data-sparkle="{{ section.settings.liquid_sparkle }}"
  data-strength="{{ section.settings.mouse_strength | divided_by: 100.0 }}"
  style="--pb-hero-bg: {{ section.settings.background }}; --pb-hero-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --pb-hero-heading-weight: {{ heading_font.weight }};"
>
  {%- if section.settings.poster != blank -%}
    {{
      section.settings.poster
      | image_url: width: 2400
      | image_tag:
        class: 'pb-hero-bottle__poster',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '800, 1200, 1600, 2400',
        alt: poster_alt
    }}
  {%- endif -%}

  {%- case section.settings.background_style -%}
    {%- when 'scroll' -%}
      {%- render 'pb-marquee',
        class: 'pb-hero-bottle__marquee',
        duration: section.settings.scroll_duration,
        loading: 'eager'
      -%}
    {%- when 'text' -%}
      {%- if section.settings.background_text != blank -%}
        <span class="pb-hero-bottle__word" aria-hidden="true">{{ section.settings.background_text }}</span>
      {%- endif -%}
  {%- endcase -%}

  <canvas class="pb-hero-bottle__canvas" aria-hidden="true"></canvas>

  {%- for side in (1..2) -%}
    {%- liquid
      if side == 1
        assign line_1 = section.settings.start_line_1
        assign line_2 = section.settings.start_line_2
        assign link = section.settings.start_link
        assign button = section.settings.start_button
        assign modifier = 'start'
      else
        assign line_1 = section.settings.end_line_1
        assign line_2 = section.settings.end_line_2
        assign link = section.settings.end_link
        assign button = section.settings.end_button
        assign modifier = 'end'
      endif
    -%}
    {%- if line_1 != blank or line_2 != blank -%}
      <div class="pb-hero-bottle__text pb-hero-bottle__text--{{ modifier }}">
        <h2 class="pb-hero-bottle__heading">
          <span class="pb-hero-bottle__line">{{ line_1 }}</span>
          <span class="pb-hero-bottle__line pb-hero-bottle__line--second">{{ line_2 }}</span>
        </h2>
        {%- if link != blank and button != blank -%}
          <a class="pb-hero-bottle__button" href="{{ link }}">
            <span class="pb-hero-bottle__button-label">{{ button }}</span>
            <svg class="pb-hero-bottle__button-arrow" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 8h11M9 4l4 4-4 4"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</pb-hero-bottle>

<script type="module" src="{{ 'pb-hero-bottle.js' | asset_url }}"></script>

{% stylesheet %}
  .pb-hero-bottle {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr minmax(0, 1.1fr) 1fr;
    align-items: center;
    min-height: max(560px, 100svh);
    padding: max(48px, var(--pb-landing-header-height, 0px)) var(--page-margin, 24px)
      max(48px, var(--pb-landing-footer-height, 0px));
    overflow: hidden;
    color: #fff;
    background: radial-gradient(
      ellipse at 50% 45%,
      color-mix(in srgb, var(--pb-hero-bg) 92%, #fff) 0%,
      var(--pb-hero-bg) 70%
    );
  }

  .pb-hero-bottle__poster,
  .pb-hero-bottle__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Scrolling wordmark (snippets/pb-marquee.liquid) behind the bottles. */
  /* Wider than the hero on both sides, so its own clipped edges stay off screen when it
     drifts with the mouse (up to 110px, PARALLAX in pb-hero-bottle.js). The hero clips it. */
  .pb-hero-bottle__marquee {
    position: absolute;
    inset-inline: -160px;
    inset-block-start: 50%;
    z-index: 0;
    translate: 0 -40%;
  }

  /* Large faint word behind the bottles. */
  .pb-hero-bottle__word {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    z-index: 0;
    translate: 0 -40%;
    overflow: hidden;
    color: rgb(255 255 255 / 0.045);
    font-size: clamp(4rem, 15.5vw, 22rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .pb-hero-bottle__poster {
    z-index: 0;
    object-fit: contain;
  }

  /* The canvas starts hidden and appears at once when its first frame is drawn (the bottles
     enter from off screen, so they are solid the whole way in; no fade). */
  .pb-hero-bottle__canvas {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .pb-hero-bottle.is-ready .pb-hero-bottle__canvas {
    opacity: 1;
  }

  /* With a still image, the 3D replaces it in a single frame (pb-hero-bottle.js draws the 3D
     in the still's pose first), so neither fades: no moment where both show. */
  .pb-hero-bottle.is-ready .pb-hero-bottle__poster {
    opacity: 0;
    transition: none;
  }

  .pb-hero-bottle__text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .pb-hero-bottle__text--start {
    align-items: flex-end;
  }

  .pb-hero-bottle__text--end {
    align-items: flex-start;
  }

  .pb-hero-bottle__heading {
    margin: 0;
    color: #fff;
    font-family: var(--pb-hero-heading-font, inherit);
    font-size: clamp(2rem, 3.4vw, 3.75rem);
    font-weight: var(--pb-hero-heading-weight, 300);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .pb-hero-bottle__line {
    display: block;
  }

  .pb-hero-bottle__line--second {
    color: #efe6e6;
  }

  /* Shop now. Hover/focus: red sweeps in from the left, the label nudges left and an arrow
     slides in on the right; press scales it down a touch. Transforms and opacity only. */
  .pb-hero-bottle__button {
    --pb-button-ease: cubic-bezier(0.22, 1, 0.36, 1);

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    padding: 11px 18px;
    border-radius: 6px;
    background: #000;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.2s var(--pb-button-ease);
  }

  .pb-hero-bottle__button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--pb-accent, #ca0d0d);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--pb-button-ease);
  }

  .pb-hero-bottle__button-label {
    transition: transform 0.45s var(--pb-button-ease);
  }

  .pb-hero-bottle__button-arrow {
    position: absolute;
    inset-inline-end: 10px;
    width: 12px;
    height: 12px;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.3s ease,
      transform 0.45s var(--pb-button-ease);
  }

  .pb-hero-bottle__button:is(:hover, :focus-visible)::before {
    transform: scaleX(1);
  }

  .pb-hero-bottle__button:is(:hover, :focus-visible) .pb-hero-bottle__button-label {
    transform: translateX(-7px);
  }

  .pb-hero-bottle__button:is(:hover, :focus-visible) .pb-hero-bottle__button-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .pb-hero-bottle__button:active {
    transform: scale(0.96);
  }

  /* Bottle hover (pb-hero-bottle.js sets data-hover and .is-active): the matching heading
     grows a little towards its bottle and its Shop now button plays its hover; the other
     heading fades back. */
  .pb-hero-bottle__text {
    transition: opacity 0.4s ease;
  }

  .pb-hero-bottle__heading {
    transition: transform 0.5s var(--pb-hover-ease, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .pb-hero-bottle__text--start .pb-hero-bottle__heading {
    transform-origin: right center;
  }

  .pb-hero-bottle__text--end .pb-hero-bottle__heading {
    transform-origin: left center;
  }

  .pb-hero-bottle[data-hover] .pb-hero-bottle__text:not(.is-active) {
    opacity: 0.35;
  }

  .pb-hero-bottle__text--start.is-active .pb-hero-bottle__heading {
    transform: translateX(10px) scale(1.05);
  }

  .pb-hero-bottle__text--end.is-active .pb-hero-bottle__heading {
    transform: translateX(-10px) scale(1.05);
  }

  .pb-hero-bottle__text.is-active .pb-hero-bottle__button::before {
    transform: scaleX(1);
  }

  .pb-hero-bottle__text.is-active .pb-hero-bottle__button-label {
    transform: translateX(-7px);
  }

  .pb-hero-bottle__text.is-active .pb-hero-bottle__button-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-hero-bottle__text,
    .pb-hero-bottle__heading,
    .pb-hero-bottle__button,
    .pb-hero-bottle__button::before,
    .pb-hero-bottle__button-label,
    .pb-hero-bottle__button-arrow {
      transition: none;
    }
  }


  .pb-hero-bottle__text--start {
    grid-column: 1;
    justify-self: end;
    margin-block-end: 8rem;
    text-align: end;
  }

  .pb-hero-bottle__text--end {
    grid-column: 3;
    justify-self: start;
    margin-block-start: 8rem;
    text-align: start;
  }

  @media screen and (max-width: 749px) {
    .pb-hero-bottle {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
      padding-block: calc(var(--pb-landing-header-height, 0px) + 16px) 32px;
    }

    .pb-hero-bottle__text--start {
      grid-row: 1;
      grid-column: 1;
      justify-self: start;
      align-self: start;
      margin: 0;
      align-items: flex-start;
      text-align: start;
    }

    .pb-hero-bottle__text--end {
      grid-row: 3;
      grid-column: 1;
      justify-self: end;
      align-self: end;
      margin: 0;
      align-items: flex-end;
      text-align: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero bottle (3D)",
  "tag": "section",
  "class": "pb-hero-bottle-section",
  "settings": [
    {
      "type": "header",
      "content": "Headings"
    },
    {
      "type": "text",
      "id": "start_line_1",
      "label": "Left heading, line 1",
      "default": "Professional"
    },
    {
      "type": "text",
      "id": "start_line_2",
      "label": "Left heading, line 2",
      "default": "Products"
    },
    {
      "type": "url",
      "id": "start_link",
      "label": "Left button link"
    },
    {
      "type": "text",
      "id": "start_button",
      "label": "Left button label",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "end_line_1",
      "label": "Right heading, line 1",
      "default": "Car care"
    },
    {
      "type": "text",
      "id": "end_line_2",
      "label": "Right heading, line 2",
      "default": "Products"
    },
    {
      "type": "url",
      "id": "end_link",
      "label": "Right button link"
    },
    {
      "type": "text",
      "id": "end_button",
      "label": "Right button label",
      "default": "Shop now"
    },
    {
      "type": "header",
      "content": "Bottle"
    },
    {
      "type": "select",
      "id": "bottles",
      "label": "Bottles",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "2"
    },
    {
      "type": "image_picker",
      "id": "label",
      "label": "Label artwork",
      "info": "The whole label laid flat, front in the middle, about 1.4 times as wide as it is tall (e.g. 2048 × 1455 px). Empty uses the Detailing Spray label."
    },
    {
      "type": "color",
      "id": "liquid_color",
      "label": "Liquid",
      "default": "#b5650e"
    },
    {
      "type": "color",
      "id": "liquid_color_2",
      "label": "Liquid, second bottle",
      "info": "The lower, right-hand bottle when showing two.",
      "default": "#0077bb"
    },
    {
      "type": "select",
      "id": "liquid_finish_2",
      "label": "Second bottle finish",
      "options": [
        {
          "value": "gel",
          "label": "Gel (clear, glossy)"
        },
        {
          "value": "liquid",
          "label": "Liquid"
        }
      ],
      "default": "gel"
    },
    {
      "type": "range",
      "id": "bottle_size",
      "label": "Bottle size",
      "info": "100% fits the bottles to the screen.",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "liquid_sparkle",
      "label": "Sparkling liquid",
      "info": "Small bubbles rising and tiny glints in the liquid.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "liquid_wobble",
      "label": "Liquid moves",
      "info": "The liquid sloshes when the bottles move. Off: it stays still and level.",
      "default": true
    },
    {
      "type": "range",
      "id": "mouse_strength",
      "label": "Mouse follow",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Reflections & lighting"
    },
    {
      "type": "range",
      "id": "highlights",
      "label": "White reflections",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gloss",
      "label": "Gloss",
      "info": "Shine on the plastic, liquid and label.",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "key_light",
      "label": "Main light",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "rim_light",
      "label": "Rim light",
      "info": "Coloured light from behind, along the bottles' left edges.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 10
    },
    {
      "type": "color",
      "id": "rim_color",
      "label": "Rim light colour",
      "default": "#ca0d0d"
    },
    {
      "type": "range",
      "id": "shadow",
      "label": "Shadow darkness",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "label": "Shadow softness",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Behind the bottles",
      "options": [
        {
          "value": "scroll",
          "label": "Scrolling wordmark"
        },
        {
          "value": "text",
          "label": "Word"
        },
        {
          "value": "none",
          "label": "Nothing"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "range",
      "id": "scroll_duration",
      "label": "Scroll speed",
      "info": "Seconds for one loop. Higher is slower.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 60,
      "visible_if": "{{ section.settings.background_style == 'scroll' }}"
    },
    {
      "type": "text",
      "id": "background_text",
      "label": "Background word",
      "default": "Protection",
      "visible_if": "{{ section.settings.background_style == 'text' }}"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#0b0b0b"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Still image",
      "info": "Shown while the 3D loads, and instead of it for visitors who turn off motion."
    }
  ],
  "presets": [
    {
      "name": "Hero bottle (3D)"
    }
  ]
}
{% endschema %}
