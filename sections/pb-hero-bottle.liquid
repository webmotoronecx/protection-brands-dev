{%- comment -%}
  Protection Brands homepage hero: one or two 3D product bottles that spin, float and
  follow the mouse, between two linked headings. The 3D is drawn by assets/pb-hero-bottle.js
  with Three.js, which loads after the page has shown. The still image (if set) shows
  first and stays for visitors who turn off motion or whose device can't draw 3D.
{%- endcomment -%}

{%- liquid
  assign label_url = 'pb-label-detailing-spray.jpg' | asset_url
  if section.settings.label != blank
    assign label_url = section.settings.label | image_url: width: 4096
  endif

  assign poster_alt = section.settings.poster.alt | default: 'Protection Brands Detailing Spray'
-%}

<pb-hero-bottle
  class="pb-hero-bottle{% if section.settings.poster != blank %} pb-hero-bottle--has-poster{% endif %}"
  data-three="{{ 'three.module.min.js' | asset_url }}"
  data-label="{{ label_url }}"
  data-bottles="{{ section.settings.bottles }}"
  data-liquid="{{ section.settings.liquid_color }}"
  data-liquid-second="{{ section.settings.liquid_color_2 }}"
  data-size="{{ section.settings.bottle_size | divided_by: 100.0 }}"
  data-strength="{{ section.settings.mouse_strength | divided_by: 100.0 }}"
  style="--pb-hero-bg: {{ section.settings.background }};"
>
  {%- if section.settings.poster != blank -%}
    {{
      section.settings.poster
      | image_url: width: 2400
      | image_tag:
        class: 'pb-hero-bottle__poster',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '800, 1200, 1600, 2400',
        alt: poster_alt
    }}
  {%- endif -%}

  {%- case section.settings.background_style -%}
    {%- when 'scroll' -%}
      {%- comment -%} Four copies; the track moves left by half its width, then repeats seamlessly. {%- endcomment -%}
      <div
        class="pb-hero-bottle__marquee"
        aria-hidden="true"
        style="--pb-marquee-duration: {{ section.settings.scroll_duration }}s;"
      >
        <div class="pb-hero-bottle__marquee-track">
          {%- for i in (1..4) -%}
            <img src="{{ 'label-scroling.svg' | asset_url }}" alt="" width="319" height="27">
          {%- endfor -%}
        </div>
      </div>
    {%- when 'text' -%}
      {%- if section.settings.background_text != blank -%}
        <span class="pb-hero-bottle__word" aria-hidden="true">{{ section.settings.background_text }}</span>
      {%- endif -%}
  {%- endcase -%}

  <canvas class="pb-hero-bottle__canvas" aria-hidden="true"></canvas>

  {%- for side in (1..2) -%}
    {%- liquid
      if side == 1
        assign line_1 = section.settings.start_line_1
        assign line_2 = section.settings.start_line_2
        assign link = section.settings.start_link
        assign modifier = 'start'
      else
        assign line_1 = section.settings.end_line_1
        assign line_2 = section.settings.end_line_2
        assign link = section.settings.end_link
        assign modifier = 'end'
      endif
    -%}
    {%- if line_1 != blank or line_2 != blank -%}
      <p class="pb-hero-bottle__text pb-hero-bottle__text--{{ modifier }}">
        {%- if link != blank -%}<a href="{{ link }}">{%- endif -%}
        <span class="pb-hero-bottle__line">{{ line_1 }}</span>
        <span class="pb-hero-bottle__line pb-hero-bottle__line--muted">{{ line_2 }}</span>
        {%- if link != blank -%}</a>{%- endif -%}
      </p>
    {%- endif -%}
  {%- endfor -%}
</pb-hero-bottle>

<script type="module" src="{{ 'pb-hero-bottle.js' | asset_url }}"></script>

{% stylesheet %}
  .pb-hero-bottle {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr minmax(0, 1.1fr) 1fr;
    align-items: center;
    min-height: max(560px, 100svh);
    padding: max(48px, var(--pb-landing-header-height, 0px)) var(--page-margin, 24px) 48px;
    overflow: hidden;
    color: #fff;
    background: radial-gradient(
      ellipse at 50% 45%,
      color-mix(in srgb, var(--pb-hero-bg) 92%, #fff) 0%,
      var(--pb-hero-bg) 70%
    );
  }

  .pb-hero-bottle__poster,
  .pb-hero-bottle__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.8s ease;
  }

  /* Scrolling wordmark behind the bottles. Only transform animates, so it runs on the compositor. */
  .pb-hero-bottle__marquee {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    z-index: 0;
    translate: 0 -40%;
    overflow: hidden;
    pointer-events: none;
  }

  .pb-hero-bottle__marquee-track {
    display: flex;
    width: max-content;
    animation: pb-hero-marquee var(--pb-marquee-duration, 60s) linear infinite;
  }

  .pb-hero-bottle__marquee-track img {
    flex: none;
    width: auto;
    height: clamp(4rem, 15.5vw, 22rem);
    margin-inline-end: 6vw;
  }

  @keyframes pb-hero-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-hero-bottle__marquee-track {
      animation: none;
    }
  }

  /* Large faint word behind the bottles. */
  .pb-hero-bottle__word {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    z-index: 0;
    translate: 0 -40%;
    overflow: hidden;
    color: rgb(255 255 255 / 0.045);
    font-size: clamp(4rem, 15.5vw, 22rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .pb-hero-bottle__poster {
    z-index: 0;
    object-fit: contain;
  }

  /* The canvas starts empty and fades in over the still image once its first frame is drawn. */
  .pb-hero-bottle__canvas {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .pb-hero-bottle.is-ready .pb-hero-bottle__canvas {
    opacity: 1;
  }

  .pb-hero-bottle.is-ready .pb-hero-bottle__poster {
    opacity: 0;
  }

  .pb-hero-bottle__text {
    position: relative;
    z-index: 2;
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .pb-hero-bottle__text a {
    color: inherit;
    text-decoration: none;
  }

  .pb-hero-bottle__line {
    display: block;
  }

  .pb-hero-bottle__line--muted {
    color: #8a8a8a;
    transition: color 0.2s ease;
  }

  .pb-hero-bottle__text a:is(:hover, :focus-visible) .pb-hero-bottle__line--muted {
    color: #fff;
  }

  .pb-hero-bottle__text--start {
    grid-column: 1;
    justify-self: end;
    margin-block-end: 8rem;
    text-align: end;
  }

  .pb-hero-bottle__text--end {
    grid-column: 3;
    justify-self: start;
    margin-block-start: 8rem;
    text-align: start;
  }

  @media screen and (max-width: 749px) {
    .pb-hero-bottle {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
      padding-block: calc(var(--pb-landing-header-height, 0px) + 16px) 32px;
    }

    .pb-hero-bottle__text--start {
      grid-row: 1;
      grid-column: 1;
      justify-self: start;
      align-self: start;
      margin: 0;
      text-align: start;
    }

    .pb-hero-bottle__text--end {
      grid-row: 3;
      grid-column: 1;
      justify-self: end;
      align-self: end;
      margin: 0;
      text-align: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero bottle (3D)",
  "tag": "section",
  "class": "pb-hero-bottle-section",
  "settings": [
    {
      "type": "header",
      "content": "Headings"
    },
    {
      "type": "text",
      "id": "start_line_1",
      "label": "Left heading, line 1",
      "default": "Professional"
    },
    {
      "type": "text",
      "id": "start_line_2",
      "label": "Left heading, line 2",
      "default": "Products"
    },
    {
      "type": "url",
      "id": "start_link",
      "label": "Left link"
    },
    {
      "type": "text",
      "id": "end_line_1",
      "label": "Right heading, line 1",
      "default": "Car care"
    },
    {
      "type": "text",
      "id": "end_line_2",
      "label": "Right heading, line 2",
      "default": "Products"
    },
    {
      "type": "url",
      "id": "end_link",
      "label": "Right link"
    },
    {
      "type": "header",
      "content": "Bottle"
    },
    {
      "type": "select",
      "id": "bottles",
      "label": "Bottles",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "2"
    },
    {
      "type": "image_picker",
      "id": "label",
      "label": "Label artwork",
      "info": "The whole label laid flat, front in the middle, about 1.4 times as wide as it is tall (e.g. 2048 × 1455 px). Empty uses the Detailing Spray label."
    },
    {
      "type": "color",
      "id": "liquid_color",
      "label": "Liquid",
      "default": "#b5650e"
    },
    {
      "type": "color",
      "id": "liquid_color_2",
      "label": "Liquid, second bottle",
      "info": "The lower, right-hand bottle when showing two.",
      "default": "#2f8fc0"
    },
    {
      "type": "range",
      "id": "bottle_size",
      "label": "Bottle size",
      "info": "100% fits the bottles to the screen.",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "mouse_strength",
      "label": "Mouse follow",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Behind the bottles",
      "options": [
        {
          "value": "scroll",
          "label": "Scrolling wordmark"
        },
        {
          "value": "text",
          "label": "Word"
        },
        {
          "value": "none",
          "label": "Nothing"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "range",
      "id": "scroll_duration",
      "label": "Scroll speed",
      "info": "Seconds for one loop. Higher is slower.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 60,
      "visible_if": "{{ section.settings.background_style == 'scroll' }}"
    },
    {
      "type": "text",
      "id": "background_text",
      "label": "Background word",
      "default": "Protection",
      "visible_if": "{{ section.settings.background_style == 'text' }}"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#0b0b0b"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Still image",
      "info": "Shown while the 3D loads, and instead of it for visitors who turn off motion."
    }
  ],
  "presets": [
    {
      "name": "Hero bottle (3D)"
    }
  ]
}
{% endschema %}
