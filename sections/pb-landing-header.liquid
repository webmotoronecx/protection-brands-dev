{%- comment -%}
  Minimal header for the landing layout (layout/pb-landing.liquid): menu button on the left,
  logo in the middle, cart on the right, floating over the page.
  The menu button opens the floating menu (<pb-menu>, assets/pb-menu.js) below.
{%- endcomment -%}

<header class="pb-landing-header">
  <button
    type="button"
    class="pb-landing-header__menu"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="PBMenu"
    aria-haspopup="dialog"
    data-pb-menu-toggle
  >
    <span class="pb-landing-header__menu-line"></span>
    <span class="pb-landing-header__menu-line"></span>
  </button>

  <a class="pb-landing-header__logo" href="{{ routes.root_url }}">
    {%- if section.settings.logo != blank -%}
      {{
        section.settings.logo
        | image_url: width: 600
        | image_tag: alt: shop.name, loading: 'eager', widths: '300, 450, 600', sizes: '225px'
      }}
    {%- else -%}
      <img
        src="{{ 'logo-protectionbrands.svg' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="225"
        height="46"
      >
    {%- endif -%}
  </a>

  <a
    class="pb-landing-header__cart"
    href="{{ routes.cart_url }}"
    aria-label="Cart, {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}"
  >
    {{- 'icon-cart.svg' | inline_asset_content -}}
    {%- if cart.item_count > 0 -%}
      <span class="pb-landing-header__count" aria-hidden="true">
        {%- if cart.item_count > 99 %}99+{% else %}{{ cart.item_count }}{% endif -%}
      </span>
    {%- endif -%}
  </a>
</header>

{%- assign menu = section.settings.menu -%}
<pb-menu>
  <dialog id="PBMenu" class="pb-menu" tabindex="-1" aria-label="{{ menu.title | default: 'Menu' | escape }}">
    <button type="button" class="pb-menu__close" aria-label="Close menu" data-pb-menu-close>
      <span class="pb-menu__close-line"></span>
      <span class="pb-menu__close-line"></span>
    </button>

    <div class="pb-menu__body">
      {%- if menu.links.size > 0 -%}
        <nav class="pb-menu__nav" aria-label="{{ menu.title | escape }}">
          <ul class="pb-menu__links">
            {%- for link in menu.links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if section.settings.categories != blank -%}
        <nav class="pb-menu__nav" aria-labelledby="PBMenuCategories">
          <h2 id="PBMenuCategories" class="pb-menu__heading">{{ section.settings.categories_heading }}</h2>
          <ul class="pb-menu__links pb-menu__links--small">
            {%- for collection in section.settings.categories -%}
              <li>
                <a
                  href="{{ collection.url }}"
                  {% if collection.url == request.path %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- collection.title -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- if section.settings.newsletter -%}
      <div class="pb-menu__newsletter">
        {%- form 'customer', id: 'PBMenuNewsletter', class: 'pb-menu__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <h2 class="pb-menu__heading">{{ section.settings.newsletter_heading }}</h2>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="pb-menu__text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            {%- comment -%} After the page reloads, pb-menu.js reopens the menu to show this. {%- endcomment -%}
            <p class="pb-menu__message" role="status" data-pb-menu-open-on-load>Thanks for subscribing.</p>
          {%- else -%}
            <div class="pb-menu__field">
              <label class="visually-hidden" for="PBMenuEmail">Email address</label>
              <input
                id="PBMenuEmail"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="Email address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="PBMenuEmailError"
                {% endif %}
              >
              <button type="submit" class="pb-menu__submit">Subscribe</button>
            </div>
            {%- if form.errors -%}
              <div id="PBMenuEmailError" class="pb-menu__message pb-menu__message--error" data-pb-menu-open-on-load>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </dialog>
</pb-menu>

<script type="module" src="{{ 'pb-menu.js' | asset_url }}"></script>

{% stylesheet %}
  .pb-landing-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--pb-landing-header-height);
    padding-inline: var(--page-margin, 24px);
    color: #fff;
  }

  .pb-landing-header__menu {
    justify-self: start;
    display: grid;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 0;
    align-content: center;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .pb-landing-header__menu-line {
    display: block;
    width: 26px;
    height: 1.5px;
    background: currentColor;
  }

  .pb-landing-header__logo {
    display: block;
    line-height: 0;
  }

  .pb-landing-header__logo img {
    width: clamp(160px, 16vw, 225px);
    height: auto;
  }

  .pb-landing-header__cart {
    position: relative;
    justify-self: end;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: inherit;
  }

  .pb-landing-header__cart svg {
    --icon-stroke-width: 1.5px;

    width: 24px;
    height: 24px;
  }

  .pb-landing-header__count {
    position: absolute;
    inset-block-start: 6px;
    inset-inline-end: 4px;
    min-width: 14px;
    height: 14px;
    padding-inline: 3px;
    border-radius: 7px;
    background: var(--pb-accent, #ca0d0d);
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    line-height: 14px;
    text-align: center;
  }

  /* Floating menu ------------------------------------------------------------------------ */

  html[data-pb-menu-open] {
    overflow: hidden;
  }

  .pb-menu {
    --pb-menu-inset: 22px;

    width: min(50vw, 640px);
    max-width: none;
    height: calc(100dvh - var(--pb-menu-inset) * 2);
    max-height: none;
    margin: var(--pb-menu-inset);
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow-y: auto;
    background: #040404;
    color: #fff;
    opacity: 0;
    translate: -24px 0;
    transition:
      opacity 0.35s ease,
      translate 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pb-menu[open] {
    display: flex;
    flex-direction: column;
  }

  /* Focus starts on the panel itself (pb-menu.js), so no ring shows on the close button
     after a mouse click; keyboard users tab to it as normal. */
  .pb-menu:focus {
    outline: none;
  }

  .pb-menu.is-open {
    opacity: 1;
    translate: 0 0;
  }

  .pb-menu::backdrop {
    background: rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .pb-menu__close {
    position: absolute;
    inset-block-start: 20px;
    inset-inline-start: 20px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .pb-menu__close-line {
    grid-area: 1 / 1;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    rotate: 45deg;
  }

  .pb-menu__close-line + .pb-menu__close-line {
    rotate: -45deg;
  }

  /* Main links and categories side by side; newsletter pinned to the bottom. */
  .pb-menu__body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    gap: 40px 48px;
    flex: 1 0 auto;
    padding: 96px 32px 40px 12%;
  }

  .pb-menu__heading {
    margin: 0 0 18px;
    color: #8a8a8a;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pb-menu__newsletter {
    padding: 32px 32px 40px 12%;
    border-block-start: 1px solid #1c1c1c;
  }

  .pb-menu__text {
    max-width: 36ch;
    margin: -8px 0 18px;
    color: #bdbdbd;
    font-size: 14px;
    line-height: 1.4;
  }

  .pb-menu__field {
    display: flex;
    gap: 12px;
    max-width: 440px;
  }

  .pb-menu__field input {
    flex: 1;
    min-width: 0;
    padding: 12px 0;
    border: 0;
    border-block-end: 1px solid #3a3a3a;
    border-radius: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 14px;
  }

  .pb-menu__field input::placeholder {
    color: #6f6f6f;
  }

  .pb-menu__field input:focus-visible {
    outline: none;
    border-block-end-color: #fff;
  }

  .pb-menu__submit {
    padding: 0 18px;
    border: 0;
    border-radius: 6px;
    background: var(--pb-accent, #ca0d0d);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .pb-menu__submit:is(:hover, :focus-visible) {
    background: var(--pb-accent-hover, #a30a0a);
  }

  .pb-menu__message {
    margin: 0;
    font-size: 14px;
  }

  .pb-menu__message--error {
    margin-block-start: 10px;
    color: #ff6b6b;
  }

  .pb-menu__message--error :is(ul, p) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pb-menu__links {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pb-menu__links a {
    color: #fff;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: -0.02em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .pb-menu__links--small a {
    font-size: 15px;
  }

  .pb-menu__links a:is(:hover, :focus-visible, [aria-current='page']) {
    color: var(--pb-accent, #ca0d0d);
  }

  @media screen and (max-width: 749px) {
    .pb-menu {
      --pb-menu-inset: 12px;

      width: calc(100vw - var(--pb-menu-inset) * 2);
    }

    .pb-menu__body {
      grid-template-columns: 1fr;
      padding: 84px 24px 32px;
    }

    .pb-menu__newsletter {
      padding: 28px 24px 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-menu {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Landing header",
  "tag": "div",
  "class": "pb-landing-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Empty uses the Protection Brands logo. Shown on a dark background, so use a light version."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Floating menu",
      "default": "main-menu",
      "info": "Opened from the menu button. Top-level links only."
    },
    {
      "type": "text",
      "id": "categories_heading",
      "label": "Categories heading",
      "default": "Categories"
    },
    {
      "type": "collection_list",
      "id": "categories",
      "label": "Categories",
      "limit": 12
    },
    {
      "type": "checkbox",
      "id": "newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "New products, offers and car care tips."
    }
  ]
}
{% endschema %}
