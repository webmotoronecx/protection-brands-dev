{%- comment -%}
  Best sellers (Protection Brands): a heading with a "View all" link, then a row of product
  cards from one collection that scrolls sideways, with previous/next buttons underneath.
  The cards are the same as the collection grid's (stars, price, Add To Cart bar): edit them
  under "Product card" in this section. Order the collection by best selling in the admin.

  On the product page (templates/product.json, "Products you might like") it can show the
  product's own collection instead: the one the visitor came from, else the product's first
  (skipping the home page and catch-all collections), leaving out the product itself.
{%- endcomment -%}

{%- liquid
  assign heading_font = settings.type_heading_font

  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif

  assign skip_id = blank
  if section.settings.product_collection and product != blank
    assign skip_id = product.id
    assign related = collection
    if related == blank
      for item in product.collections
        unless item.handle == 'frontpage' or item.handle == 'all'
          assign related = item
          break
        endunless
      endfor
    endif
    if related != blank
      assign source = related
    endif
  endif

  assign max_items = section.settings.max_products

  assign link = section.settings.link | default: source.url
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
</style>

<div
  class="pb-best-sellers"
  style="--pb-best-bg: {{ section.settings.background }}; --pb-best-text: {{ section.settings.text_color }}; --pb-best-font: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --pb-best-weight: {{ heading_font.weight }};"
>
  <div class="pb-best-sellers__inner">
    <div class="pb-best-sellers__header" data-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="pb-best-sellers__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.link_label != blank and link != blank -%}
        <a class="pb-best-sellers__link" href="{{ link }}">
          {{- section.settings.link_label -}}
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17 17 7M8 7h9v9"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <pb-carousel class="pb-best-sellers__carousel">
      <ul class="pb-best-sellers__track" role="list" data-reveal tabindex="0" aria-label="{{ section.settings.heading | default: 'Products' | escape }}">
        {%- if source.products_count > 0 -%}
          {%- assign shown = 0 -%}
          {%- for product in source.products -%}
            {%- if product.id == skip_id -%}{%- continue -%}{%- endif -%}
            {%- if shown >= max_items -%}{%- break -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <li class="pb-best-sellers__item">
              {% content_for 'block',
                type: '_product-card',
                id: 'static-product-card',
                closest.product: product,
                product_view_context: 'collection'
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li class="pb-best-sellers__item">
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      <div class="pb-best-sellers__nav">
        <button type="button" class="pb-best-sellers__button" data-pb-carousel-prev aria-label="Previous products" disabled>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 5-7 7 7 7"/>
          </svg>
        </button>
        <button type="button" class="pb-best-sellers__button" data-pb-carousel-next aria-label="Next products">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 5 7 7-7 7"/>
          </svg>
        </button>
      </div>
    </pb-carousel>
  </div>
</div>

{% javascript %}
  /*
    <pb-carousel>: previous/next buttons for a sideways-scrolling list. Each press scrolls
    one screen of cards; the buttons switch off at either end. Scroll snapping is in CSS.
  */
  if (!customElements.get('pb-carousel')) {
    customElements.define(
      'pb-carousel',
      class extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('ul');
          this.prev = this.querySelector('[data-pb-carousel-prev]');
          this.next = this.querySelector('[data-pb-carousel-next]');
          if (!this.track || !this.prev || !this.next) return;

          this.update = this.update.bind(this);
          this.prev.addEventListener('click', () => this.go(-1));
          this.next.addEventListener('click', () => this.go(1));
          this.track.addEventListener('scroll', this.update, { passive: true });
          this.observer = new ResizeObserver(this.update);
          this.observer.observe(this.track);
          this.update();
        }

        disconnectedCallback() {
          this.observer?.disconnect();
        }

        go(direction) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          // One screen of cards: the row's width less its side padding (it runs to the screen edges).
          const style = getComputedStyle(this.track);
          const width = this.track.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
          this.track.scrollBy({ left: direction * width, behavior: reduce ? 'auto' : 'smooth' });
        }

        update() {
          const { scrollLeft, scrollWidth, clientWidth } = this.track;
          const max = scrollWidth - clientWidth;
          this.prev.disabled = Math.abs(scrollLeft) <= 1;
          this.next.disabled = Math.abs(scrollLeft) >= max - 1;
          this.toggleAttribute('data-static', max <= 1);
        }
      }
    );
  }
{% endjavascript %}

{% stylesheet %}
  .pb-best-sellers {
    background: var(--pb-best-bg, #fff);
    color: var(--pb-best-text, #111);
  }

  .pb-best-sellers__inner {
    --pb-best-gutter: clamp(16px, 2.5vw, 40px);

    padding: clamp(40px, 5vw, 72px) var(--pb-best-gutter) clamp(32px, 3vw, 48px);
  }

  .pb-best-sellers__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(16px, 2vw, 24px);
  }

  .pb-best-sellers__heading {
    margin: 0;
    color: inherit;
    font-family: var(--pb-best-font, inherit);
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: var(--pb-best-weight, 400);
    line-height: 1.05;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .pb-best-sellers__link {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 4px;
    color: var(--pb-accent, #ca0d0d);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .pb-best-sellers__link svg {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .pb-best-sellers__link:is(:hover, :focus-visible) svg {
    transform: translate(2px, -2px);
  }

  /* contain: the cards' widths come from this box, so they can't widen the page. */
  .pb-best-sellers__carousel {
    display: block;
    contain: inline-size;
  }

  /* One screen holds 4 cards on desktop, 3 on tablets, and 1½ on phones so the next one peeks in. */
  .pb-best-sellers__track {
    --pb-best-gap: 16px;
    --pb-best-per-view: 4;

    display: grid;
    grid-auto-columns: calc((100% - (var(--pb-best-per-view) - 1) * var(--pb-best-gap)) / var(--pb-best-per-view));
    grid-auto-flow: column;
    gap: var(--pb-best-gap);
    /* Flush to the screen edges: the row runs under the section's side padding, so cards
       scroll out at the edge of the screen, while padding (and scroll-padding, for snapping)
       keeps the first and last cards in line with the heading. */
    margin: 0 calc(-1 * var(--pb-best-gutter));
    padding: 0 var(--pb-best-gutter);
    scroll-padding-inline: var(--pb-best-gutter);
    overflow-x: auto;
    /* Without this, overflow-y computes to auto, and the cards' reveal offset and hidden
       Add To Cart bar make the row scroll vertically: Lenis hands wheel scrolls to it and
       the page stalls until it runs out. */
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }

  .pb-best-sellers__track::-webkit-scrollbar {
    display: none;
  }

  .pb-best-sellers__track:focus-visible {
    outline: 2px solid var(--pb-accent, #ca0d0d);
    outline-offset: 4px;
  }

  .pb-best-sellers__item {
    min-width: 0;
    scroll-snap-align: start;  }

  .pb-best-sellers__item > * {
    height: 100%;
  }

  .pb-best-sellers__nav {
    display: flex;
    gap: 10px;
    margin-top: clamp(16px, 2vw, 24px);
  }

  .pb-best-sellers__carousel[data-static] .pb-best-sellers__nav {
    display: none;
  }

  .pb-best-sellers__button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: var(--pb-card-bg, #f4f4f4);
    color: inherit;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .pb-best-sellers__button svg {
    width: 16px;
    height: 16px;
  }

  .pb-best-sellers__button:not(:disabled):is(:hover, :focus-visible) {
    background: var(--pb-buy-bg, #000);
    color: var(--pb-buy-text, #fff);
  }

  .pb-best-sellers__button:disabled {
    cursor: default;
    opacity: 0.35;
  }

  @media screen and (max-width: 989px) {
    .pb-best-sellers__track {
      --pb-best-per-view: 3;
    }
  }

  @media screen and (max-width: 749px) {
    .pb-best-sellers__inner {
      --pb-best-gutter: 16px;
    }

    .pb-best-sellers__track {
      --pb-best-gap: 8px;
      --pb-best-per-view: 1.6;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Best sellers (PB)",
  "tag": "section",
  "class": "pb-best-sellers-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Shows this collection's products in its own sort order. Leave empty for all products."
    },
    {
      "type": "checkbox",
      "id": "product_collection",
      "label": "On product pages, show the product's collection",
      "info": "For \"Products you might like\": the collection the visitor came from, else the product's first. The product itself is left out.",
      "default": false
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Defaults to the collection."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Best sellers (PB)"
    }
  ]
}
{% endschema %}
