{%- comment -%}
  Protection Brands collection header: a rounded dark card with the wordmark
  (snippets/pb-marquee.liquid, inverted file) along the top, following the mouse or
  scrolling, the collection title, large, light and uppercase, and a row of category links
  (current one underlined in red). On phones the row scrolls sideways. Categories are picked
  in the theme editor.

  On the search page it shows the search title, the result count and a search box instead
  of a collection title (used by templates/search.json).

  It is the title bar for every inner page. The title comes from the page itself
  (collection, page, blog; an article shows its blog's name) or, for pages without one
  (cart, collections list, 404), from the "Title" setting. On the cart it also shows the
  item count and hides the cart's own small heading.
{%- endcomment -%}

{%- liquid
  assign heading_font = settings.type_body_font | font_modify: 'weight', '300'
  if heading_font == blank
    assign heading_font = settings.type_body_font
  endif

  assign current = collection
  if current == blank
    assign current = closest.collection
  endif

  assign is_search = false
  if request.page_type == 'search'
    assign is_search = true
  endif

  case request.page_type
    when 'page'
      assign title = page.title
    when 'blog', 'article'
      assign title = blog.title
    else
      assign title = current.title
  endcase
  if title == blank
    assign title = section.settings.fallback_title
  endif
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
</style>

<div
  class="pb-collection-header"
  style="--pb-collection-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --pb-collection-heading-weight: {{ heading_font.weight }};"
>
  {%- if section.settings.marquee -%}
    {%- liquid
      assign marquee_static = true
      if section.settings.marquee_motion == 'scroll'
        assign marquee_static = false
      endif
    -%}
    {%- render 'pb-marquee',
      class: 'pb-collection-header__marquee',
      file: 'label-scroling-invert.svg',
      duration: section.settings.marquee_duration,
      static: marquee_static,
      follow_mouse: marquee_static,
      loading: 'eager'
    -%}
  {%- endif -%}

  {%- if is_search -%}
    <h1 class="pb-collection-header__title">{{ section.settings.search_title }}</h1>

    {%- if search.performed -%}
      <p class="pb-collection-header__meta" role="status">
        {{ search.results_count }}
        {{ search.results_count | pluralize: 'result', 'results' }} for &ldquo;{{ search.terms | escape }}&rdquo;
      </p>
    {%- endif -%}

    <form action="{{ routes.search_url }}" method="get" role="search" class="pb-collection-header__search">
      <input type="hidden" name="options[prefix]" value="last">
      <label class="visually-hidden" for="PBSearchInput">Search products</label>
      <input
        id="PBSearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      >
      <button type="submit" aria-label="Search">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="11" cy="11" r="6.5"/>
          <path d="m16 16 4 4"/>
        </svg>
      </button>
    </form>
  {%- else -%}
    <h1 class="pb-collection-header__title">{{ title }}</h1>

    {%- if request.page_type == 'cart' and cart.item_count > 0 -%}
      <p class="pb-collection-header__meta">
        {{ cart.item_count }}
        {{ cart.item_count | pluralize: 'item', 'items' }}
      </p>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.show_description and current.description != blank -%}
    <div class="pb-collection-header__description rte">{{ current.description }}</div>
  {%- endif -%}

  {%- if section.settings.categories != blank -%}
    <nav class="pb-collection-header__nav" aria-label="{{ section.settings.nav_label | escape }}">
      <ul class="pb-collection-header__categories">
        {%- for category in section.settings.categories -%}
          <li>
            <a
              href="{{ category.url }}"
              {% if category.handle == current.handle %}
                aria-current="page"
              {% endif %}
            >
              {{- category.title -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- elsif request.design_mode -%}
    <p class="pb-collection-header__hint">Pick the categories for this row in the section settings.</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .pb-collection-header {
    --pb-collection-pad-x: clamp(24px, 4.5vw, 64px);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 0 10px 14px;
    padding: clamp(96px, 9vw, 130px) var(--pb-collection-pad-x) clamp(32px, 3.5vw, 52px);
    border-radius: 12px;
    background:
      radial-gradient(ellipse 60% 90% at 20% 60%, #1c1c1c 0%, transparent 70%),
      linear-gradient(120deg, #111 0%, #0b0b0b 60%, #0d0d0d 100%);
    color: #fff;
  }

  /* Wordmark along the top, cut off by the top of the card. */
  .pb-collection-header__marquee {
    --pb-marquee-height: clamp(4rem, 14vw, 17rem);

    /* Wider than the card, so its clipped edges stay hidden when it drifts with the mouse
       (up to 40px, pb-marquee.js); the card clips it. */
    position: absolute;
    inset-inline: -80px;
    inset-block-start: calc(var(--pb-marquee-height) * -0.2);
    z-index: -1;
  }

  .pb-collection-header__title {
    max-width: 16ch;
    margin: 0;
    color: #fff;
    font-family: var(--pb-collection-heading-font, inherit);
    font-size: clamp(2.25rem, 3.4vw, 3.5rem);
    font-weight: var(--pb-collection-heading-weight, 300);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* The cart's own small "Cart (n)" heading repeats the title bar; hide it when the bar is there. */
  body:has(.pb-collection-header) .cart-title {
    display: none;
  }

  .pb-collection-header__meta {
    margin: 14px 0 0;
    color: #bdbdbd;
    font-size: 15px;
  }

  /* Search box: dark field with a red button, like the footer signup. */
  .pb-collection-header__search {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 520px;
    margin-block-start: 28px;
    padding: 8px 8px 8px 20px;
    border-radius: 8px;
    background: rgb(0 0 0 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .pb-collection-header__search:focus-within {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .pb-collection-header__search input {
    flex: 1;
    min-width: 0;
    padding: 10px 0;
    border: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 17px;
  }

  .pb-collection-header__search input::placeholder {
    color: #6f6f6f;
  }

  .pb-collection-header__search input:focus-visible {
    outline: none;
  }

  /* Hide the browser's own clear (x) button; the field is cleared by selecting the text. */
  .pb-collection-header__search input::-webkit-search-cancel-button {
    appearance: none;
  }

  .pb-collection-header__search button {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: var(--pb-accent, #ca0d0d);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .pb-collection-header__search button:is(:hover, :focus-visible) {
    background: var(--pb-accent-hover, #a30a0a);
  }

  .pb-collection-header__search svg {
    width: 20px;
    height: 20px;
  }

  .pb-collection-header__description {
    max-width: 60ch;
    margin-block-start: 16px;
    color: #cfcfcf;
  }

  .pb-collection-header__nav {
    margin-block-start: clamp(40px, 6vw, 88px);
  }

  .pb-collection-header__categories {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 45px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pb-collection-header__categories a {
    color: #fff;
    font-size: 17px;
    text-decoration: none;
    white-space: nowrap;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .pb-collection-header__categories a:is(:hover, :focus-visible) {
    text-decoration-line: underline;
    text-decoration-color: rgb(255 255 255 / 0.5);
  }

  .pb-collection-header__categories a[aria-current='page'] {
    text-decoration-line: underline;
    text-decoration-color: var(--pb-accent, #ca0d0d);
  }

  .pb-collection-header__hint {
    margin: 24px 0 0;
    color: #9a9a9a;
    font-size: 14px;
  }

  /* Phones: one row that scrolls sideways, edge to edge of the card. */
  @media screen and (max-width: 749px) {
    .pb-collection-header {
      --pb-collection-pad-x: 18px;

      margin-inline: 8px;
    }

    .pb-collection-header__nav {
      margin-inline: calc(var(--pb-collection-pad-x) * -1);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .pb-collection-header__nav::-webkit-scrollbar {
      display: none;
    }

    .pb-collection-header__categories {
      flex-wrap: nowrap;
      gap: 28px;
      width: max-content;
      padding-inline: var(--pb-collection-pad-x);
      padding-block-end: 8px;
    }

    .pb-collection-header__categories a {
      font-size: 15px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Title bar (PB)",
  "tag": "section",
  "class": "pb-collection-header-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": false
    },
    {
      "type": "collection_list",
      "id": "categories",
      "label": "Categories",
      "limit": 16
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Category row label",
      "info": "Read out by screen readers.",
      "default": "Categories"
    },
    {
      "type": "text",
      "id": "search_title",
      "label": "Search page title",
      "default": "Search results"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Title",
      "info": "Used on pages without a title of their own: cart, collections list, 404, all products.",
      "default": "Products"
    },
    {
      "type": "checkbox",
      "id": "marquee",
      "label": "Show scrolling wordmark",
      "default": true
    },
    {
      "type": "select",
      "id": "marquee_motion",
      "label": "Wordmark motion",
      "options": [
        {
          "value": "mouse",
          "label": "Follows the mouse"
        },
        {
          "value": "scroll",
          "label": "Scrolls"
        }
      ],
      "default": "mouse",
      "visible_if": "{{ section.settings.marquee }}"
    },
    {
      "type": "range",
      "id": "marquee_duration",
      "label": "Scroll speed",
      "visible_if": "{{ section.settings.marquee and section.settings.marquee_motion == 'scroll' }}",
      "info": "Seconds for one loop. Higher is slower.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Title bar (PB)"
    }
  ]
}
{% endschema %}
