{%- comment -%}
  Products bar (Protection Brands): above the product grid, the number of products as a
  heading on the left ("24 Products", counting only the current tag's products on a tag page)
  and Sort on the right. Used by the default collection template (templates/collection.json)
  in place of Horizon's own count and sort row, which is turned off there in the product
  grid's Filters block. Also on the search page (templates/search.json): the number of
  results, and Sort keeps the search terms.

  Sort is snippets/pb-sort-menu.liquid: "Sort: Best selling", opening a panel of the options.
  Lined up with the product grid by Horizon's page-width grid (.section); the margins for both
  are set together in assets/pb-product-card.css.
{%- endcomment -%}

{%- liquid
  assign current = collection
  if current == blank
    assign current = closest.collection
  endif
  assign count = current.products_count | default: 0
  assign sortable = current
  if request.page_type == 'search'
    assign count = search.results_count | default: 0
    assign sortable = search
  endif
-%}

<div class="pb-products-bar section">
  <div class="pb-products-bar__inner">
    <h2 class="pb-products-bar__count">
      {{ count }}
      {%- if request.page_type == 'search' %}
        {{ count | pluralize: 'Result', 'Results' }}
      {%- else %}
        {{ count | pluralize: 'Product', 'Products' }}
      {%- endif %}
    </h2>

    {%- if section.settings.show_sort -%}
      {%- render 'pb-sort-menu', collection: sortable, label: section.settings.sort_label -%}
    {%- endif -%}
  </div>

  {%- comment -%}
    Phones: the sort pills in a row that scrolls sideways, in place of the sort
    menu (snippets/pb-facet-pills.liquid); the Filter button below opens the rest. Desktop has
    them in the filter row instead (blocks/filters.liquid).
  {%- endcomment -%}
  {%- if section.settings.show_sort -%}
    <div class="pb-products-bar__pills pb-facet-pills">
      {%- render 'pb-facet-pills', sort: true, results: sortable -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .pb-products-bar {
    padding-block: clamp(28px, 2.9vw, 42px) clamp(16px, 1.9vw, 27px);
  }

  .pb-products-bar__pills {
    display: none;
  }

  /* Phones on a page with the filter pills: the pills row replaces the sort menu. */
  @media screen and (max-width: 749px) {
    body:has(.pb-facet-pills .pb-pill-group--sort) .pb-products-bar pb-sort-menu {
      display: none;
    }

    .pb-products-bar__pills {
      display: flex;
      flex-wrap: nowrap;
      gap: 8px;
      margin: 16px calc(-1 * var(--page-margin, 16px)) 0;
      padding-inline: var(--page-margin, 16px);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .pb-products-bar__pills::-webkit-scrollbar {
      display: none;
    }

    .pb-products-bar__pills .pb-pill-group {
      flex-wrap: nowrap;
    }
  }

  .pb-products-bar__inner {
    display: flex;
    color: #000;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .pb-products-bar__count {
    margin: 0;
    color: #000;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 1.7vw, 1.5rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Products bar (PB)",
  "tag": "section",
  "class": "pb-products-bar-section",
  "enabled_on": {
    "templates": ["collection", "search"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort",
      "info": "Turn off Horizon's own sort in the product grid's Filters settings to avoid showing both.",
      "default": true
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort label",
      "default": "Sort",
      "visible_if": "{{ section.settings.show_sort }}"
    }
  ],
  "presets": [
    {
      "name": "Products bar (PB)"
    }
  ]
}
{% endschema %}
