{%- comment -%}
  Shop by category (Protection Brands): a grid of photo tiles, each linking to a collection.
  A tile takes its collection's image and title; the tile's own image and label replace
  them. Label bottom-left over a dark fade, a » arrow bottom-right that turns red on hover.
  Setup: docs/store-setup/category-tiles-and-brand-logos.md.
{%- endcomment -%}

{%- liquid
  assign heading_font = settings.type_heading_font

  case section.settings.columns
    when '5'
      assign sizes = '(min-width: 990px) calc((100vw - 84px) / 5), (min-width: 750px) calc((100vw - 52px) / 3), calc((100vw - 24px) / 2)'
    when '3'
      assign sizes = '(min-width: 990px) calc((100vw - 52px) / 3), (min-width: 750px) calc((100vw - 52px) / 3), calc((100vw - 24px) / 2)'
    else
      assign sizes = '(min-width: 990px) calc((100vw - 68px) / 4), (min-width: 750px) calc((100vw - 52px) / 3), calc((100vw - 24px) / 2)'
  endcase

  # Nothing to show (no tile has a collection yet): render nothing, not an empty heading.
  for block in section.blocks
    if block.settings.collection != blank
      assign has_tiles = true
      break
    endif
  endfor
-%}

{%- if has_tiles or request.design_mode -%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
</style>

<div
  class="pb-category-tiles pb-category-tiles--{{ section.settings.ratio }} pb-category-tiles--heading-{{ section.settings.heading_alignment }} pb-category-tiles--label-{{ section.settings.label_alignment }}"
  style="--pb-tiles-columns: {{ section.settings.columns }}; --pb-tiles-font: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --pb-tiles-weight: {{ heading_font.weight }};{% if section.settings.background != blank %} --pb-tiles-bg: {{ section.settings.background }};{% endif %}{% if section.settings.text_color != blank %} --pb-tiles-text: {{ section.settings.text_color }};{% endif %}"
>
  {%- liquid
    assign show_link = false
    if section.settings.link_label != blank and section.settings.link != blank
      assign show_link = true
    endif
  -%}
  {%- if section.settings.heading != blank or show_link -%}
    <div class="pb-category-tiles__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="pb-category-tiles__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if show_link -%}
        <a class="pb-category-tiles__link" href="{{ section.settings.link }}">
          {{- section.settings.link_label -}}
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17 17 7M8 7h9v9"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ul class="pb-category-tiles__grid" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_collection = block.settings.collection
        if tile_collection == blank and request.design_mode == false
          continue
        endif
        assign tile_image = block.settings.image | default: tile_collection.featured_image
        assign tile_label = block.settings.label | default: tile_collection.title
      -%}
      <li {{ block.shopify_attributes }}>
        {%- if tile_collection != blank -%}
          <a class="pb-category-tiles__tile" href="{{ tile_collection.url }}">
        {%- else -%}
          <div class="pb-category-tiles__tile pb-category-tiles__tile--empty">
        {%- endif -%}

        {%- if tile_image != blank -%}
          {{-
            tile_image
            | image_url: width: 1080
            | image_tag:
              class: 'pb-category-tiles__image',
              alt: '',
              loading: 'lazy',
              widths: '360, 540, 720, 1080',
              sizes: sizes
          -}}
        {%- endif -%}

        <span class="pb-category-tiles__label">
          {%- if tile_collection != blank -%}
            {{ tile_label }}
          {%- else -%}
            Pick a collection
          {%- endif -%}
        </span>

        {%- if tile_collection != blank -%}
            <svg class="pb-category-tiles__arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="m5 5 7 7-7 7M12 5l7 7-7 7"/>
            </svg>
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>
{%- endif -%}

{% stylesheet %}
  .pb-category-tiles {
    padding: clamp(40px, 5vw, 72px) clamp(16px, 2.5vw, 40px);
    background: var(--pb-tiles-bg, transparent);
    color: var(--pb-tiles-text, inherit);
  }

  .pb-category-tiles__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 8px 16px;
    margin-bottom: clamp(20px, 2.5vw, 32px);
  }

  .pb-category-tiles--heading-left .pb-category-tiles__header {
    justify-content: space-between;
  }

  .pb-category-tiles__link {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 4px;
    color: var(--pb-accent, #ca0d0d);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .pb-category-tiles__link svg {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }

  .pb-category-tiles__link:is(:hover, :focus-visible) svg {
    transform: translate(2px, -2px);
  }

  .pb-category-tiles__heading {
    margin: 0;
    color: inherit;
    font-family: var(--pb-tiles-font, inherit);
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: var(--pb-tiles-weight, 400);
    line-height: 1.05;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
  }

  .pb-category-tiles__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .pb-category-tiles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media screen and (min-width: 990px) {
    .pb-category-tiles__grid {
      grid-template-columns: repeat(var(--pb-tiles-columns, 4), minmax(0, 1fr));
    }
  }

  .pb-category-tiles__tile {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    gap: 12px;
    aspect-ratio: 1;
    padding: clamp(14px, 1.6vw, 24px);
    overflow: hidden;
    border-radius: 8px;
    background: #111;
    color: #fff;
    text-decoration: none;
  }

  .pb-category-tiles--landscape .pb-category-tiles__tile {
    aspect-ratio: 4 / 3;
  }

  .pb-category-tiles--portrait .pb-category-tiles__tile {
    aspect-ratio: 3 / 4;
  }

  .pb-category-tiles--tall .pb-category-tiles__tile {
    aspect-ratio: 7 / 8;
  }

  /* Centred labels: no arrow, the label sits centred along the bottom. */
  .pb-category-tiles--label-center .pb-category-tiles__label {
    text-align: center;
  }

  .pb-category-tiles--label-center .pb-category-tiles__arrow {
    display: none;
  }

  /* Dark fade from the bottom so the label reads on any photo. */
  .pb-category-tiles__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(0 0 0 / 0.7) 0%, transparent 55%);
  }

  .pb-category-tiles__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .pb-category-tiles__label {
    flex: 1;
    display: -webkit-box;
    overflow: hidden;
    font-family: var(--pb-tiles-font, inherit);
    font-size: clamp(1.25rem, 2vw, 2rem);
    font-weight: var(--pb-tiles-weight, 400);
    line-height: 1.05;
    text-transform: uppercase;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .pb-category-tiles__arrow {
    flex: none;
    width: clamp(22px, 2.2vw, 32px);
    height: clamp(22px, 2.2vw, 32px);
    transition: color 0.2s ease;
  }

  a.pb-category-tiles__tile:is(:hover, :focus-visible) .pb-category-tiles__arrow {
    color: var(--pb-accent, #ca0d0d);
  }

  a.pb-category-tiles__tile:focus-visible {
    outline: 2px solid var(--pb-accent, #ca0d0d);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    a.pb-category-tiles__tile:is(:hover, :focus-visible) .pb-category-tiles__image {
      transform: scale(1.04);
    }
  }

  .pb-category-tiles__tile--empty {
    border: 1px dashed rgb(255 255 255 / 0.3);
    color: #9a9a9a;
  }

  @media screen and (max-width: 749px) {
    .pb-category-tiles {
      padding-inline: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles (PB)",
  "tag": "section",
  "class": "pb-category-tiles-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "info": "Tablets show 3, phones 2.",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Tile shape",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        },
        {
          "value": "tall",
          "label": "Slightly tall (7:8)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading position",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "left",
          "label": "Left, link on the right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "label_alignment",
      "label": "Tile labels",
      "options": [
        {
          "value": "left",
          "label": "Left, with arrow"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Optional, e.g. \"All categories\". Shown beside the heading."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "info": "Optional. Defaults to the page background."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading colour"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "The tile links here and uses its image and title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Replaces the collection's image on this tile."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Optional. Replaces the collection's title on this tile."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles (PB)",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
