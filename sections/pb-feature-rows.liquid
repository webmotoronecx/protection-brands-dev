{%- comment -%}
  Image with text (PB): a stack of rows, each a block, for the brand pages
  (templates/collection.brand-*.json) and anywhere else. Each row's Layout picks its look:

  - Text: a small label and a large heading on the left, the text on the right (a page intro).
  - Image left / Image right: a rounded photo on one side, label, heading, text and button on
    the other.
  - Banner: a full-width photo, darkened, with one centred statement and an optional button.

  Lists in the text show in two columns with small red square bullets ("Two-column lists").
  A row can have a watermark: one word drawn large and faint behind it.

  An image row with no photo picked shows assets/image-default.webp (1200 x 1200, dark with the
  logo in the middle). A banner without one shows assets/pb-feat-row.webp (2880 x 1280, a
  detailer polishing a black car).

  On phones every row is one column, photo first.
{%- endcomment -%}

{%- liquid
  assign heading_font = settings.type_heading_font
  assign watermark_font = section.settings.watermark_font
-%}

<style>
  {{ watermark_font | font_face: font_display: 'swap' }}
</style>

{%- if section.blocks.size > 0 -%}
<div
  class="pb-feature-rows"
  style="--pb-watermark-font: {{ watermark_font.family }}, {{ watermark_font.fallback_families }}; --pb-watermark-weight: {{ watermark_font.weight }}; --pb-feature-bg: {{ section.settings.background }}; --pb-feature-text: {{ section.settings.text_color }}; --pb-feature-gap: {{ section.settings.row_gap }}px; --pb-feature-font: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --pb-feature-weight: {{ heading_font.weight }};"
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign has_button = false
      if b.button_label != blank and b.button_link != blank
        assign has_button = true
      endif
      assign ratio = b.image_ratio
      if ratio == 'original'
        assign ratio = b.image.aspect_ratio | default: '4 / 3'
      endif
      # The frame is 24% shorter than the photo (frame ratio = photo ratio x 1.24), so the photo
      # shows at the frame's width, never scaled up, and slides inside it for the parallax.
      assign ratio_parts = ratio | append: '' | split: '/'
      assign frame_ratio = ratio_parts[0] | strip | times: 1.24
      if ratio_parts.size > 1
        assign ratio_h = ratio_parts[1] | strip | times: 1.0
        assign frame_ratio = frame_ratio | divided_by: ratio_h
      endif
      assign heading_tag = 'h2'
      if b.layout == 'banner'
        assign heading_tag = 'p'
      endif
    -%}

    <div
      class="pb-feature-rows__row pb-feature-rows__row--{{ b.layout }}{% if b.list_columns %} pb-feature-rows__row--list-columns{% endif %}{% if b.layout == 'text' %} pb-feature-rows__row--text-{{ b.text_align | default: 'start' }}{% endif %}"
      {% if b.layout == 'banner' %}
        style="--pb-feature-banner-h: {{ b.banner_height }}px; --pb-feature-overlay: {{ b.overlay | divided_by: 100.0 }};"
      {% endif %}
      {{ block.shopify_attributes }}
    >
      {%- if b.watermark != blank -%}
        <span class="pb-feature-rows__watermark" aria-hidden="true">{{ b.watermark | escape }}</span>
      {%- endif -%}

      {%- if b.layout == 'banner' -%}
        {%- if b.image != blank -%}
          {{
            b.image
            | image_url: width: 2400
            | image_tag:
              class: 'pb-feature-rows__banner-image',
              loading: 'lazy',
              sizes: '100vw',
              widths: '750, 1100, 1500, 1920, 2400',
              alt: b.image.alt
          }}
        {%- else -%}
          <img
            class="pb-feature-rows__banner-image"
            src="{{ 'pb-feat-row.webp' | asset_url }}"
            alt=""
            width="2880"
            height="1280"
            loading="lazy"
          >
        {%- endif -%}
        <div class="pb-feature-rows__banner-content" data-reveal>
          {%- if b.heading != blank -%}
            <{{ heading_tag }} class="pb-feature-rows__statement">{{ b.heading | escape }}</{{ heading_tag }}>
          {%- endif -%}
          {%- if has_button -%}
            <div>
              {%- render 'pb-feature-rows-button', row: b -%}
            </div>
          {%- endif -%}
        </div>
        {%- if b.banner_note != blank -%}
          <p class="pb-feature-rows__banner-note" data-reveal>{{ b.banner_note | escape }}</p>
        {%- endif -%}
      {%- else -%}
        <div class="pb-feature-rows__inner">
          {%- if b.layout != 'text' -%}
            <div class="pb-feature-rows__media" style="--pb-feature-ratio: {{ ratio }}; --pb-feature-frame-ratio: {{ frame_ratio }};">
              {%- if b.image != blank -%}
                {{
                  b.image
                  | image_url: width: 2400
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) min(50vw, 800px), 100vw',
                    widths: '600, 900, 1200, 1600, 2000, 2400',
                    alt: b.image.alt
                }}
              {%- else -%}
                <img src="{{ 'image-default.webp' | asset_url }}" alt="" width="1200" height="1200" loading="lazy">
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if b.layout == 'text' -%}
            <div class="pb-feature-rows__aside" data-reveal>
              {%- if b.label != blank -%}
                <p class="pb-feature-rows__label">{{ b.label | escape }}</p>
              {%- endif -%}
              {%- if b.heading != blank -%}
                <h2 class="pb-feature-rows__heading pb-feature-rows__heading--large">{{ b.heading | escape }}</h2>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="pb-feature-rows__content" data-reveal>
            {%- if b.layout != 'text' -%}
              {%- if b.label != blank -%}
                <p class="pb-feature-rows__label">{{ b.label | escape }}</p>
              {%- endif -%}
              {%- if b.heading != blank -%}
                <h2 class="pb-feature-rows__heading">{{ b.heading | escape }}</h2>
              {%- endif -%}
            {%- endif -%}
            {%- if b.text != blank -%}
              <div class="pb-feature-rows__text">{{ b.text }}</div>
            {%- endif -%}
            {%- if has_button -%}
              <div>
                {%- render 'pb-feature-rows-button', row: b -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>
{%- endif -%}

{% stylesheet %}
  /* Section-specific styles for pb-feature-rows. */

  .pb-feature-rows {
    display: grid;
    gap: var(--pb-feature-gap, 96px);
    overflow-x: clip;
    padding-block: clamp(56px, 7vw, 104px);
    background: var(--pb-feature-bg, #fff);
    color: var(--pb-feature-text, #111);
  }

  /* A banner alone fills the section edge to edge, with no white band above or below. */
  .pb-feature-rows:has(> .pb-feature-rows__row--banner:only-child) {
    padding-block: 0;
  }

  /* Same side margins as the product rows (sections/pb-best-sellers.liquid), so headings,
     photos and cards line up down the page. */
  .pb-feature-rows__row {
    position: relative;
    isolation: isolate;
    padding-inline: calc(clamp(16px, 2.5vw, 40px) + var(--pb-wide-inset, 0px));
  }

  .pb-feature-rows__inner {
    display: grid;
    gap: 32px;
  }

  /* A row with a watermark: space inside its top, so more of the word shows above the photo
     and text (the word is placed from the row's top). */
  .pb-feature-rows__row:not(.pb-feature-rows__row--banner):has(> .pb-feature-rows__watermark) {
    padding-block-start: clamp(48px, 7vw, 120px);
  }

  /* The watermark: one word, as wide as the screen, faint and fading downwards, behind the
     top of the row. */
  .pb-feature-rows__watermark {
    position: absolute;
    inset-block-start: clamp(-120px, -7vw, -32px);
    inset-inline-start: 50%;
    z-index: -1;
    /* The brand banner's watermark font (sections/pb-brand-header.liquid). */
    font-family: var(--pb-watermark-font, inherit);
    /* Same size and spacing as the banner's watermark word (snippets/pb-marquee.liquid at
       --pb-marquee-height: clamp(4.8rem, 18vw, 21.6rem)). */
    font-size: calc(clamp(4.8rem, 18vw, 21.6rem) * 1.35);
    font-weight: var(--pb-watermark-weight, 600);
    line-height: 0.74;
    letter-spacing: -0.04em; /* -1.2rem at full size, scaled down with the word on phones */
    white-space: nowrap;
    text-transform: uppercase;
    color: transparent;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.06), rgb(0 0 0 / 0) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    /* Centred, and lifted by a tenth of its height. --pb-watermark-shift slides it up into
       place as the row scrolls in (assets/pb-motion.js). */
    transform: translate(-50%, calc(-10% + var(--pb-watermark-shift, 0%)));
    pointer-events: none;
    user-select: none;
  }

  .pb-feature-rows__label {
    margin: 0 0 20px;
    color: #737373;
    font-family: var(--pb-button-font, inherit);
    font-size: 12px;
    font-weight: var(--pb-button-weight, 600);
    letter-spacing: 0.12em;
    line-height: normal;
    text-transform: uppercase;
  }

  .pb-feature-rows__heading {
    margin: 0;
    color: #000;
    font-family: var(--pb-feature-font, inherit);
    font-size: clamp(26px, 2.5vw, 40px);
    font-weight: var(--pb-feature-weight, 400);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .pb-feature-rows__heading--large {
    font-size: clamp(30px, 3.4vw, 52px);
    line-height: 1.08;
  }

  .pb-feature-rows__heading + .pb-feature-rows__text {
    margin-block-start: clamp(20px, 2.4vw, 36px);
  }

  .pb-feature-rows__text {
    color: #222;
    font-size: 15px;
    line-height: 1.65;
  }

  .pb-feature-rows__text > * {
    margin: 0;
  }

  .pb-feature-rows__text > * + * {
    margin-block-start: 1.1em;
  }

  .pb-feature-rows__text :is(b, strong) {
    color: #000;
    font-weight: 700;
  }

  .pb-feature-rows__text a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--pb-accent, #ca0d0d);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* Lists: small red squares; two columns when the row asks for them. */
  .pb-feature-rows__text ul {
    display: grid;
    gap: 14px 32px;
    padding: 0;
    list-style: none;
  }

  .pb-feature-rows__text li {
    position: relative;
    padding-inline-start: 18px;
    color: #000;
    font-weight: 500;
    line-height: 1.4;
  }

  .pb-feature-rows__text li::before {
    content: '';
    position: absolute;
    inset-block-start: 0.5em;
    inset-inline-start: 0;
    width: 6px;
    height: 6px;
    background: var(--pb-accent, #ca0d0d);
  }

  .pb-feature-rows__text ul + * {
    margin-block-start: 2em;
  }

  .pb-feature-rows__content > div:has(.pb-feature-rows__button) {
    margin-block-start: clamp(24px, 3vw, 40px);
  }

  .pb-feature-rows__media {
    overflow: hidden;
    aspect-ratio: var(--pb-feature-frame-ratio, 1.6533);
    border-radius: 6px;
    /* No fill: a cut-out image (transparent background) sits on the section's background. */
  }

  /* The photo at its own ratio and the frame's width (not zoomed, so it stays sharp): 24% taller
     than the frame and centred in it (-9.68% of its own height), so the parallax in
     assets/pb-motion.js (--pb-media-shift, -9% to 9% of the photo's height) never shows an edge.
     The frame stays still and clips it. */
  .pb-feature-rows__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--pb-feature-ratio, 4 / 3);
    object-fit: cover;
    transform: translateY(calc(-9.68% + var(--pb-media-shift, 0%)));
  }

  /* Banner */
  .pb-feature-rows__row--banner {
    /* The banner's height: "Banner height", but no taller than the screen, and at most 520px
       on phones (raised from 750px below). */
    --pb-banner-min: min(var(--pb-feature-banner-h, 700px), 100vh, 520px);

    display: grid;
    place-items: center;
    overflow: hidden;
    min-height: var(--pb-banner-min);
    padding-block: clamp(64px, 8vw, 120px);
    background: #111;
    color: #fff;
    text-align: center;
  }

  .pb-feature-rows__row--banner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Clear at the top to black at the bottom, at "Darken the photo" (100% by default). */
    background: linear-gradient(to bottom, rgb(0 0 0 / 0), #000);
    opacity: var(--pb-feature-overlay, 1);
  }

  /* 24% taller than the banner (12% above and below), so the parallax in assets/pb-motion.js
     (--pb-banner-shift, -8% to 8% of the photo's height) never shows an edge. */
  .pb-feature-rows__banner-image {
    position: absolute;
    inset: -12% 0 auto;
    z-index: -2;
    width: 100%;
    height: 124%;
    object-fit: cover;
    transform: translateY(var(--pb-banner-shift, 0%));
  }

  /* On the photo the watermark sits along the bottom, white at the top fading downwards. */
  .pb-feature-rows__row--banner .pb-feature-rows__watermark {
    inset-block: auto clamp(-48px, -3vw, -16px);
    z-index: 0;
    transform: translate(-50%, var(--pb-watermark-shift, 0%));
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.1) 10%, rgb(255 255 255 / 0) 90%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .pb-feature-rows__banner-content {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: clamp(28px, 4vw, 56px);
    max-width: 62rem;
    /* Sits 10% of the banner's height above centre (with or without a button). A margin, not a
       transform: data-reveal animates the transform. */
    margin-block-end: calc(var(--pb-banner-min) * 0.2);
  }

  /* The banner's small line: pinned near the bottom, centred, over the watermark. */
  .pb-feature-rows__banner-note {
    position: absolute;
    z-index: 1;
    inset-inline: clamp(16px, 4vw, 64px);
    bottom: clamp(32px, 5vw, 72px);
    margin: 0;
    font-size: clamp(16px, 1.6vw, 24px);
    line-height: 1.35;
    text-align: center;
    text-wrap: balance;
  }

  .pb-feature-rows__statement {
    margin: 0;
    font-family: var(--pb-feature-font, inherit);
    font-size: clamp(28px, 3.6vw, 56px);
    font-weight: var(--pb-feature-weight, 400);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* Button: red, black sweeps in from the left on hover and an arrow slides in (the homepage
     button reversed, so it shows on a photo). Transforms and opacity only. */
  .pb-feature-rows__button {
    --pb-button-ease: cubic-bezier(0.22, 1, 0.36, 1);

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    padding: 18px 40px;
    border-radius: 6px;
    background: var(--pb-accent, #ca0d0d);
    color: #fff;
    font-family: var(--pb-button-font, inherit);
    font-size: 14px;
    font-weight: var(--pb-button-weight, 600);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.2s var(--pb-button-ease);
  }

  .pb-feature-rows__button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #000;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--pb-button-ease);
  }

  .pb-feature-rows__button-label {
    transition: transform 0.45s var(--pb-button-ease);
  }

  .pb-feature-rows__button-arrow {
    position: absolute;
    inset-inline-end: 14px;
    width: 13px;
    height: 13px;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.3s ease,
      transform 0.45s var(--pb-button-ease);
  }

  .pb-feature-rows__button:is(:hover, :focus-visible)::before {
    transform: scaleX(1);
  }

  .pb-feature-rows__button:is(:hover, :focus-visible) .pb-feature-rows__button-label {
    transform: translateX(-8px);
  }

  .pb-feature-rows__button:is(:hover, :focus-visible) .pb-feature-rows__button-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .pb-feature-rows__button:active {
    transform: scale(0.96);
  }

  @media screen and (min-width: 750px) {
    .pb-feature-rows__row--list-columns .pb-feature-rows__text ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pb-feature-rows__row--banner {
      --pb-banner-min: min(var(--pb-feature-banner-h, 700px), 100vh);
    }
  }

  @media screen and (min-width: 990px) {
    .pb-feature-rows__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(48px, 6vw, 96px);
      align-items: center;
    }

    .pb-feature-rows__row--text .pb-feature-rows__inner {
      align-items: start;
    }

    /* Text layout: "Text position" lines the text up with the heading's middle or bottom. */
    .pb-feature-rows__row--text-center .pb-feature-rows__inner {
      align-items: center;
    }

    .pb-feature-rows__row--text-end .pb-feature-rows__inner {
      align-items: end;
    }

    .pb-feature-rows__row--image_right .pb-feature-rows__media {
      order: 2;
    }

    .pb-feature-rows__row--image_left .pb-feature-rows__content {
      padding-inline-end: clamp(0px, 3vw, 48px);
    }

    .pb-feature-rows__row--image_right .pb-feature-rows__content {
      padding-inline-start: clamp(0px, 1vw, 16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-feature-rows__button,
    .pb-feature-rows__button::before,
    .pb-feature-rows__button-label,
    .pb-feature-rows__button-arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text (PB)",
  "tag": "section",
  "class": "pb-feature-rows-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Each block is one row. Pick its look under Layout: an intro (Text), a photo beside the text (Image left / Image right), or a full-width photo with one statement (Banner)."
    },
    {
      "type": "font_picker",
      "id": "watermark_font",
      "label": "Watermark font",
      "info": "As the brand banner's watermark (Barlow).",
      "default": "barlow_n6"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Space between rows",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "text", "label": "Text (heading left, text right)" },
            { "value": "image_left", "label": "Image left" },
            { "value": "image_right", "label": "Image right" },
            { "value": "banner", "label": "Banner (full-width photo)" }
          ],
          "default": "image_left"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "visible_if": "{{ block.settings.layout != 'text' }}"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image shape",
          "options": [
            { "value": "4 / 3", "label": "Landscape (4:3)" },
            { "value": "1 / 1", "label": "Square" },
            { "value": "4 / 5", "label": "Portrait (4:5)" },
            { "value": "original", "label": "Image's own shape" }
          ],
          "default": "4 / 3",
          "visible_if": "{{ block.settings.layout == 'image_left' or block.settings.layout == 'image_right' }}"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Small text above the heading, e.g. the brand name.",
          "visible_if": "{{ block.settings.layout != 'banner' }}"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "On a banner, the statement over the photo."
        },
        {
          "type": "text",
          "id": "banner_note",
          "label": "Small text at the bottom",
          "info": "A short line near the bottom of the banner, e.g. \"Ask your dealer…\".",
          "visible_if": "{{ block.settings.layout == 'banner' }}"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "visible_if": "{{ block.settings.layout != 'banner' }}"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text position",
          "info": "Where the text sits beside the heading, on wider screens.",
          "options": [
            { "value": "start", "label": "Top" },
            { "value": "center", "label": "Middle" },
            { "value": "end", "label": "Bottom" }
          ],
          "default": "start",
          "visible_if": "{{ block.settings.layout == 'text' }}"
        },
        {
          "type": "checkbox",
          "id": "list_columns",
          "label": "Two-column lists",
          "info": "Bulleted lists in the text show in two columns on wider screens.",
          "default": true,
          "visible_if": "{{ block.settings.layout != 'banner' }}"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Leave empty for no button."
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_new_tab",
          "label": "Open the link in a new tab",
          "info": "For links to other websites.",
          "default": false
        },
        {
          "type": "text",
          "id": "watermark",
          "label": "Watermark",
          "info": "One word drawn large and faint behind the row, e.g. the brand name. Leave empty for none."
        },
        {
          "type": "range",
          "id": "banner_height",
          "label": "Banner height",
          "min": 320,
          "max": 900,
          "step": 20,
          "unit": "px",
          "default": 700,
          "visible_if": "{{ block.settings.layout == 'banner' }}"
        },
        {
