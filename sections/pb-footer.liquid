{%- comment -%}
  Protection Brands footer for inner pages (footer group in layout/theme.liquid): a full-width
  dark panel that the page above curves down into, with the newsletter signup on the left, up to four link columns on the right,
  a copyright line and social icons, and the scrolling wordmark (snippets/pb-marquee.liquid)
  along the bottom.

  Column blocks: "Menu column" (a Shopify menu) or "Links column" (up to four links set
  here, e.g. the OptiVAN and Permagard sites and Instagram).
{%- endcomment -%}

{%- comment -%}
  data-pb-footer: as it scrolls in, the panel (the content, over the footer's background, which
  stays put) slides down from under the page's curved edge and its contents fade in
  (assets/pb-motion.js).
{%- endcomment -%}
{%- liquid
  # Background texture: the section's image, or the theme's dark texture (assets/bg-black.jpg).
  assign texture_url = 'bg-black.jpg' | asset_url
  if section.settings.background_image != blank
    assign texture_url = section.settings.background_image | image_url: width: 2400
  endif
-%}
<footer
  class="pb-footer"
  data-pb-footer
  style="--pb-footer-columns: {{ section.blocks.size | at_least: 1 }};{% if section.settings.background_texture %} --pb-footer-texture: url('{{ texture_url }}');{% endif %}"
>
  <div class="pb-footer__panel">
    <div class="pb-footer__top">
      {%- if section.settings.newsletter -%}
        <div class="pb-footer__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="pb-footer__title">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}

          {%- form 'customer', id: 'PBFooterNewsletter', class: 'pb-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="pb-footer__message" role="status">Thanks for subscribing.</p>
            {%- else -%}
              <div class="pb-footer__field">
                <label class="visually-hidden" for="PBFooterEmail">Email address</label>
                <input
                  id="PBFooterEmail"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="Enter your email"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="PBFooterEmailError"
                  {% endif %}
                >
                <button type="submit" class="pb-footer__submit" aria-label="Subscribe">
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <path d="M3 9h12M10 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              {%- if form.errors -%}
                <div id="PBFooterEmailError" class="pb-footer__message pb-footer__message--error">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="pb-footer__columns">
          {%- for block in section.blocks -%}
            <nav class="pb-footer__column" {{ block.shopify_attributes }} aria-labelledby="PBFooterHeading-{{ block.id }}">
              <h2 id="PBFooterHeading-{{ block.id }}" class="pb-footer__heading">{{ block.settings.heading }}</h2>
              <ul class="pb-footer__links">
                {%- case block.type -%}
                  {%- when 'menu' -%}
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  {%- when 'links' -%}
                    {%- for i in (1..4) -%}
                      {%- liquid
                        assign label_key = 'label_' | append: i
                        assign url_key = 'url_' | append: i
                        assign label = block.settings[label_key]
                        assign url = block.settings[url_key]
                      -%}
                      {%- if label != blank and url != blank -%}
                        <li>
                          <a
                            href="{{ url }}"
                            {% if block.settings.new_tab %}
                              target="_blank" rel="noopener"
                            {% endif %}
                          >
                            {{- label -}}
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                {%- endcase -%}
              </ul>
            </nav>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pb-footer__bottom">
      <p class="pb-footer__copyright">
        {%- if section.settings.copyright != blank -%}
          {{ section.settings.copyright }}
        {%- else -%}
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        {%- endif -%}
      </p>

      {%- liquid
        assign socials = 'instagram,facebook,youtube,tiktok,linkedin' | split: ','
        assign has_social = false
        for platform in socials
          assign key = platform | append: '_url'
          if section.settings[key] != blank
            assign has_social = true
          endif
        endfor
      -%}
      {%- if has_social -%}
        <ul class="pb-footer__social">
          {%- for platform in socials -%}
            {%- assign key = platform | append: '_url' -%}
            {%- assign url = section.settings[key] -%}
            {%- if url != blank -%}
              <li>
                <a href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ platform | capitalize }}">
                  <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                    {%- render 'icon', icon: platform -%}
                  </svg>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.marquee -%}
      {%- render 'pb-marquee', class: 'pb-footer__marquee', duration: section.settings.marquee_duration -%}
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  /* The footer clips the panel, so the panel can start hidden above it, under the curve.
     The background is on the footer, not the panel, so it stays whole while the panel's
     contents slide in over it. */
  .pb-footer {
    --pb-footer-curve: clamp(10px, 1.25vw, 18px);

    position: relative;
    overflow: hidden;
    background:
      var(--pb-footer-texture, none) center / cover no-repeat,
      radial-gradient(ellipse 60% 70% at 20% 40%, #1c1c1c 0%, transparent 70%),
      linear-gradient(120deg, #111 0%, #0b0b0b 60%, #0d0d0d 100%);
    color: #fff;
  }

  .pb-footer__panel {
    position: relative;
    overflow: hidden;
    padding: calc(clamp(48px, 7vw, 120px) + var(--pb-footer-curve)) calc(clamp(24px, 5vw, 84px) + var(--pb-wide-inset, 0px)) 0;
  }

  /* The page above curves down into the footer: a strip of page background along the top
     with rounded bottom corners, so the dark footer shows in the corners. */
  .pb-footer::before {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 0 0 auto;
    height: var(--pb-footer-curve);
    border-radius: 0 0 var(--pb-footer-curve) var(--pb-footer-curve);
    background: var(--color-background, #fff);
  }

  .pb-footer__top {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 48px;
  }

  .pb-footer__title {
    max-width: 16ch;
    margin: 0 0 28px;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .pb-footer__field {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 414px;
    padding: 12px 14px 12px 22px;
    border-radius: 8px;
    background: #050505;
  }

  .pb-footer__field input {
    flex: 1;
    min-width: 0;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 18px;
  }

  .pb-footer__field input::placeholder {
    color: #6f6f6f;
  }

  .pb-footer__field input:focus-visible {
    outline: none;
  }

  .pb-footer__field:focus-within {
    box-shadow: 0 0 0 1px #5a5a5a;
  }

  .pb-footer__submit {
    display: grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: var(--pb-accent, #ca0d0d);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .pb-footer__submit:is(:hover, :focus-visible) {
    background: var(--pb-accent-hover, #a30a0a);
  }

  .pb-footer__message {
    margin: 0;
    font-size: 15px;
  }

  .pb-footer__message--error {
    margin-block-start: 10px;
    color: #ff6b6b;
  }

  .pb-footer__message--error :is(ul, p) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pb-footer__columns {
    display: grid;
    grid-template-columns: repeat(var(--pb-footer-columns), minmax(0, 1fr));
    gap: 32px;
  }

  .pb-footer__heading {
    margin: 0 0 22px;
    font-family: var(--font-heading--family, inherit);
    font-size: 19px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .pb-footer__links {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pb-footer__links a {
    color: #9a9a9a;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pb-footer__links a:is(:hover, :focus-visible) {
    color: #fff;
  }

  .pb-footer__bottom {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-block-start: clamp(40px, 5vw, 72px);
    padding-block-start: 24px;
    border-block-start: 1px solid rgb(255 255 255 / 0.08);
  }

  .pb-footer__copyright {
    margin: 0;
    color: #7a7a7a;
    font-size: 12px;
  }

  .pb-footer__social {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pb-footer__social a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #9a9a9a;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .pb-footer__social a:is(:hover, :focus-visible) {
    background: rgb(255 255 255 / 0.06);
    color: #fff;
  }

  .pb-footer__social svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Scrolling wordmark, full footer width, cut off by the bottom of the footer. */
  /* The whole word shows, with a little room under it (the footer clips anything lower). */
  .pb-footer__marquee {
    --pb-marquee-height: clamp(4rem, 15vw, 20rem);

    margin-block: clamp(24px, 3vw, 48px) clamp(12px, 1.5vw, 24px);
    /* Cancels the footer's side padding (wide-screen inset included), so the wordmark runs
       to the screen edges. */
    margin-inline: calc((clamp(24px, 5vw, 84px) + var(--pb-wide-inset, 0px)) * -1);
  }

  @media screen and (max-width: 989px) {
    .pb-footer__top {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .pb-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pb-footer__field input {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer (PB)",
  "tag": "section",
  "class": "pb-footer-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "background_texture",
      "label": "Background texture",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Texture image",
      "info": "Defaults to the dark Protection Brands texture.",
      "visible_if": "{{ section.settings.background_texture }}"
    },
    {
      "type": "checkbox",
      "id": "newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Subscribe for news & promotions"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "info": "Empty shows \"© [year] [store name]. All rights reserved.\""
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn"
    },
    {
      "type": "header",
      "content": "Scrolling wordmark"
    },
    {
      "type": "checkbox",
      "id": "marquee",
      "label": "Show scrolling wordmark",
      "default": true
    },
    {
      "type": "range",
      "id": "marquee_duration",
      "label": "Scroll speed",
      "info": "Seconds for one loop. Higher is slower.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Information"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "links",
      "name": "Links column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Our brands"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in a new tab",
          "default": true
        },
        {
          "type": "text",
          "id": "label_1",
          "label": "Link 1 label"
        },
        {
          "type": "url",
          "id": "url_1",
          "label": "Link 1"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Link 2 label"
        },
        {
          "type": "url",
          "id": "url_2",
          "label": "Link 2"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Link 3 label"
        },
        {
          "type": "url",
          "id": "url_3",
          "label": "Link 3"
        },
        {
          "type": "text",
          "id": "label_4",
          "label": "Link 4 label"
        },
        {
          "type": "url",
          "id": "url_4",
          "label": "Link 4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer (PB)",
      "blocks": [
        {
          "type": "menu"
        }
      ]
    }
  ]
}
{% endschema %}
