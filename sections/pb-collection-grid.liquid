{%- comment -%}
  Collection grid (Protection Brands): every collection as a tile, styled like the homepage
  category tiles (sections/pb-category-tiles.liquid): a dark square on the studio spotlight
  (assets/bg-cat.png), the photo whole and a little smaller than the tile, a dark fade at the
  bottom with the name in the heading font and the number of products under it. Used by templates/list-collections.json (/collections).

  Collections: the ones picked, otherwise every collection with products, A to Z (without the
  shop's automatic "all" and "frontpage"). A tile shows its collection's image, or the first
  product's when it has none.
{%- endcomment -%}

{%- liquid
  assign heading_font = settings.type_heading_font
  assign picked = section.settings.collections
  if picked != blank
    assign list = picked
  else
    assign list = collections | sort: 'title'
  endif

  case section.settings.columns
    when '3'
      assign sizes = '(min-width: 990px) 33vw, (min-width: 750px) 33vw, 50vw'
    when '5'
      assign sizes = '(min-width: 990px) 20vw, (min-width: 750px) 33vw, 50vw'
    else
      assign sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  endcase
-%}

<div
  class="pb-collection-grid"
  style="--pb-tile-bg: url('{{ 'bg-cat.png' | asset_url }}'); --pb-grid-columns: {{ section.settings.columns }}; --pb-grid-font: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --pb-grid-weight: {{ heading_font.weight }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="pb-collection-grid__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <ul class="pb-collection-grid__list" role="list">
    {%- for collection in list -%}
      {%- liquid
        if picked == blank
          if collection.handle == 'all' or collection.handle == 'frontpage' or collection.all_products_count == 0
            continue
          endif
        endif
        assign image = collection.featured_image
        if image == blank
          assign image = collection.products.first.featured_media.preview_image
        endif
      -%}
      <li>
        <a class="pb-collection-grid__card" href="{{ collection.url }}">
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 900
              | image_tag:
                class: 'pb-collection-grid__image',
                alt: '',
                loading: 'lazy',
                widths: '300, 450, 600, 900',
                sizes: sizes
            }}
          {%- endif -%}
          <span class="pb-collection-grid__text">
            <span class="pb-collection-grid__title">{{ collection.title | escape }}</span>
            {%- if section.settings.show_count -%}
              <span class="pb-collection-grid__count">
                {{- collection.all_products_count }}
                {{ collection.all_products_count | pluralize: 'product', 'products' -}}
              </span>
            {%- endif -%}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .pb-collection-grid {
    padding: 40px var(--page-margin, 24px) 72px;
  }

  .pb-collection-grid__heading {
    margin: 0 0 24px;
    font-family: var(--pb-grid-font);
    font-size: clamp(22px, 2vw, 28px);
    font-weight: var(--pb-heading-medium-weight, 500);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .pb-collection-grid__list {
    display: grid;
    grid-template-columns: repeat(var(--pb-grid-columns, 4), minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (max-width: 989px) {
    .pb-collection-grid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .pb-collection-grid {
      padding-block: 28px 48px;
    }

    .pb-collection-grid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  .pb-collection-grid__card {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    gap: 12px;
    aspect-ratio: 1;
    padding: clamp(14px, 1.6vw, 24px);
    overflow: hidden;
    border-radius: 8px;
    background: var(--pb-tile-bg, none) center / cover no-repeat, #111;
    color: #fff;
    text-decoration: none;
  }

  /* Dark fade from the bottom so the name reads on any photo. */
  .pb-collection-grid__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(0 0 0 / 0.7) 0%, transparent 55%);
  }

  /* The whole photo, a little smaller than the tile, centred a little above the name. */
  .pb-collection-grid__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 40%;
    transform: scale(0.78);
    transform-origin: 50% 40%;
    transition: scale 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pb-collection-grid__card:is(:hover, :focus-visible) .pb-collection-grid__image {
    scale: 0.96;
  }

  .pb-collection-grid__card:focus-visible {
    outline: 2px solid var(--pb-accent, #ca0d0d);
    outline-offset: 3px;
  }

  .pb-collection-grid__text {
    flex: 1;
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .pb-collection-grid__title {
    display: -webkit-box;
    overflow: hidden;
    font-family: var(--pb-grid-font);
    font-size: clamp(1rem, 1.5vw, 1.5rem);
    font-weight: var(--pb-grid-weight, 400);
    line-height: 1.05;
    text-transform: uppercase;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .pb-collection-grid__count {
    color: rgb(255 255 255 / 0.65);
    font-size: 13px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-collection-grid__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection grid (PB)",
  "tag": "section",
  "class": "pb-collection-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "info": "Empty: every collection with products, A to Z.",
      "limit": 50
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show number of products",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection grid (PB)"
    }
  ]
}
{% endschema %}
