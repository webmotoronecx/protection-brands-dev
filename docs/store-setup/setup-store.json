{
  "_readme": "What setup-store.mjs creates on a store. See automated-setup.md. Keep in step with README.md, sds.md and categories-dev-to-live.md.",

  "metaobjectDefinitions": [
    {
      "type": "sds_document",
      "name": "SDS document",
      "displayNameKey": "product_name",
      "storefront": "PUBLIC_READ",
      "fields": [
        { "key": "product_name", "name": "Product name", "type": "single_line_text_field", "required": true },
        { "key": "file", "name": "File", "type": "file_reference", "required": true },
        {
          "key": "brand",
          "name": "Brand",
          "type": "single_line_text_field",
          "choices": ["Permagard", "CERFACE", "OptiVAN", "Honda Genuine Car Care", "Protection Brands"]
        },
        { "key": "issue_date", "name": "Issue date", "type": "date" }
      ]
    }
  ],

  "metafieldDefinitions": [
    {
      "ownerType": "PRODUCT",
      "namespace": "custom",
      "key": "suitable_for",
      "name": "Suitable for",
      "type": "list.single_line_text_field",
      "choices": ["Permagard", "CERFACE", "OptiVAN", "Honda Genuine Car Care"],
      "collectionCondition": true
    },
    {
      "ownerType": "PRODUCT",
      "namespace": "custom",
      "key": "sds",
      "name": "SDS",
      "type": "metaobject_reference",
      "metaobjectType": "sds_document"
    },
    {
      "ownerType": "PRODUCT",
      "namespace": "custom",
      "key": "how_to_use",
      "name": "How to use",
      "type": "multi_line_text_field"
    },
    {
      "ownerType": "COLLECTION",
      "namespace": "custom",
      "key": "hero_image",
      "name": "Hero image",
      "type": "file_reference",
      "fileTypes": ["Image"]
    },
    {
      "ownerType": "COLLECTION",
      "namespace": "custom",
      "key": "watermark",
      "name": "Watermark",
      "type": "single_line_text_field"
    }
  ],

  "files": [
    { "dir": "../../../product-images/upload-webp", "pattern": "\\.webp$" }
